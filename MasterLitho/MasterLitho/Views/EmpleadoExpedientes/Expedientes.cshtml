@model IEnumerable<MasterLitho.Models.EXPEDIENTE>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Mis Expedientes";
}

<div class="container mt-4">
    <div class="row">
        <h2>Mis Expedientes</h2>
    </div>

    <div class="row">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info">
                    No tienes expedientes creados.
                </div>
            </div>
        }
        else
        {
            foreach (var exp in Model)
            {
                <div class="col-md-4 col-sm-6 my-3">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="card-title"><strong>Nombre del Expediente:</strong> @exp.NOMBRE_EXPEDIENTE</h5>
                            <p class="card-text">
                                <strong>Fecha Creación:</strong> @exp.FECHA_CREACION.ToString("yyyy-MM-dd HH:mm")
                            </p>
                            <!-- Si quieres más info, la agregas aquí -->
                            <!-- Botón para ver documentos -->
                            <a href="@Url.Action("DetalleMisDocumentos", "EmpleadoExpedientes", new { id = exp.ID_EXPEDIENTE })"
                               class="btn btn-primary">
                                Ver Documentos
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

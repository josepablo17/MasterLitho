
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>MasterLithoADMIN</title>



</head>

<body id="page-top">
    <div class="container">
        <h1 class="my-4">Detalles del Reporte</h1>

        <!-- Información del Reporte -->
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Reporte de Queja de Usuario</h5>
                <p><strong>Tema:</strong> Retraso en pagos</p>
                <p>
                    <strong>Descripción:</strong> El usuario informa que no se le ha realizado el pago de su
                    salario correspondiente al mes de julio.
                </p>
                <p><strong>Fecha de Reporte:</strong> 10 de agosto de 2024</p>
                <p><strong>Estado:</strong> Pendiente</p>
            </div>
        </div>

        <!-- Respuesta del Administrador -->
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">Responder Reporte</h5>
                <form>
                    <div class="form-group">
                        <label for="respuesta">Escribe tu respuesta:</label>
                        <textarea id="respuesta" class="form-control" rows="4"
                                  placeholder="Escribe tu respuesta aquí..."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">Enviar Respuesta</button>
                    <button type="button" class="btn btn-danger">Marcar como Resuelto</button>
                </form>
            </div>
        </div>

        <!-- Registro Histórico -->
        <h3 class="my-4">Historial de Interacciones</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Interacción</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>10 de agosto de 2024</td>
                    <td>El reporte fue recibido por el administrador.</td>
                </tr>
                <tr>
                    <td>11 de agosto de 2024</td>
                    <td>
                        Respuesta enviada por el administrador: "Estamos trabajando en resolver el problema,
                        disculpa los inconvenientes."
                    </td>
                </tr>
            </tbody>
        </table>

        <a href="Reportes_QuejasAdmin.html" class="btn btn-primary btn-sm">Volver</a>
    </div>

    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- Logout Modal-->
    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>

</body>

</html>
@model List<MasterLitho.Models.tVacaciones>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="container mt-5 mb-5">
    <h2 class="text-center text-dark fw-bold mb-4">
        <i class="fas fa-calendar-check me-2 text-primary"></i> Mis Solicitudes de Vacaciones
    </h2>

    <form method="get" action="@Url.Action("ConsultarMisSolicitudes", "SolicitudVacaciones")" class="row mb-4">
        <div class="col-md-4 offset-md-4">
            <label for="estado" class="form-label">Filtrar por estado:</label>
            <select name="estado" id="estado" class="form-select" onchange="this.form.submit()">
                <option value="todos" @(ViewBag.EstadoActual == "todos" ? "selected" : "")>Todos</option>
                <option value="pendiente" @(ViewBag.EstadoActual == "pendiente" ? "selected" : "")>Pendientes</option>
                <option value="aceptado" @(ViewBag.EstadoActual == "aceptado" ? "selected" : "")>Aceptados</option>
                <option value="rechazado" @(ViewBag.EstadoActual == "rechazado" ? "selected" : "")>Rechazados</option>
            </select>
        </div>
    </form>


    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                string badgeClass = "bg-secondary";

                if (item.nombreEstado == "Pendiente")
                {
                    badgeClass = "bg-warning text-dark";
                }
                else if (item.nombreEstado == "Aceptada")
                {
                    badgeClass = "bg-success";
                }
                else if (item.nombreEstado == "Rechazada")
                {
                    badgeClass = "bg-danger";
                }

                <div class="col-md-6 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <span class="fw-semibold text-muted">
                                <i class="far fa-calendar-alt me-1"></i> @item.fechaSolicitud.ToString("dd MMM yyyy")
                            </span>
                            <span class="badge @badgeClass">@item.nombreEstado</span>
                        </div>

                        <div class="card-body">
                            <p class="mb-2"><strong>Desde:</strong> @item.fechaInicio.ToString("dd MMM yyyy")</p>
                            <p class="mb-2"><strong>Hasta:</strong> @item.fechaFin.ToString("dd MMM yyyy")</p>
                            <p class="mb-3"><strong>Días solicitados:</strong> @item.diasSolicitados</p>

                            <button class="btn btn-outline-primary w-100"
                                    data-solicitud='@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(item))'
                                    onclick="abrirModal(this)">
                                <i class="fas fa-eye me-1"></i> Ver información
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4">
            <i class="fas fa-info-circle me-2"></i> Aún no has enviado ninguna solicitud de vacaciones.
        </div>
    }
</div>

<!-- Modal -->
<div class="modal fade" id="detalleSolicitudModal" tabindex="-1" role="dialog" aria-labelledby="detalleSolicitudModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detalleSolicitudModalLabel">Detalles de la Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar">
                </button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="form-group">
                        <label for="detalleFechaSolicitud">Fecha de la Solicitud</label>
                        <input type="text" id="detalleFechaSolicitud" class="form-control" readonly>
                    </div>
                    <div class="form-group">
                        <label for="detalleFechaInicio">Fecha de Inicio</label>
                        <input type="text" id="detalleFechaInicio" class="form-control" readonly>
                    </div>
                    <div class="form-group">
                        <label for="detalleFechaFin">Fecha de Fin</label>
                        <input type="text" id="detalleFechaFin" class="form-control" readonly>
                    </div>
                    <div class="form-group">
                        <label for="detalleDiasSolicitados">Días Solicitados</label>
                        <input type="text" id="detalleDiasSolicitados" class="form-control" readonly>
                    </div>
                    <div class="form-group">
                        <label for="detalleEstado">Estado</label>
                        <input type="text" id="detalleEstado" class="form-control" readonly>
                    </div>
                    <div class="form-group">
                        <label for="detalleComentario">Comentario del Administrador</label>
                        <textarea id="detalleComentario" class="form-control" rows="3" readonly></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>



<script>
    function abrirModal(button) {
        const data = $(button).data('solicitud'); // Obtén los datos del atributo JSON

        // Formatear las fechas al formato deseado
        const fechaSolicitud = new Date(data.fechaSolicitud).toLocaleDateString('es-ES');
        const fechaInicio = new Date(data.fechaInicio).toLocaleDateString('es-ES');
        const fechaFin = new Date(data.fechaFin).toLocaleDateString('es-ES');

        // Asignar los valores al modal
        $('#detalleFechaSolicitud').val(fechaSolicitud);
        $('#detalleFechaInicio').val(fechaInicio);
        $('#detalleFechaFin').val(fechaFin);
        $('#detalleDiasSolicitados').val(data.diasSolicitados);
        $('#detalleEstado').val(data.nombreEstado);
        $('#detalleComentario').val(data.comentario);

        // Abrir el modal
        $('#detalleSolicitudModal').modal('show');
    }


</script>


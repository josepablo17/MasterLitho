@model MasterLitho.Models.tVacaciones

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-4 rounded-top">
                    <h3 class="fw-bold mb-1">
                        <i class="fas fa-plane-departure me-2"></i> Solicitud de Vacaciones
                    </h3>
                    <small class="fst-italic">Rellena los campos para enviar tu solicitud</small>
                </div>

                <div class="card-body px-4 py-4">
                    @using (Html.BeginForm("SolicitarVacaciones", "SolicitudVacaciones", FormMethod.Post, new { id = "formSolicitud" }))
                    {
                        @Html.HiddenFor(m => m.idUsuario)

                        <!-- Días disponibles -->
                        <div class="form-floating mb-4">
                            @Html.TextBoxFor(m => m.diasVacacionesDisponibles, new { @class = "form-control", @readonly = "readonly", @id = "diasDisponibles" })
                            <label for="diasDisponibles">Días disponibles</label>
                        </div>

                        <!-- Fecha inicio -->
                        <div class="form-floating mb-4">
                            @Html.TextBoxFor(m => m.fechaInicio, new { @class = "form-control", @type = "date", @id = "fechaInicio", @required = "required" })
                            <label for="fechaInicio">Fecha de inicio</label>
                        </div>

                        <!-- Fecha fin -->
                        <div class="form-floating mb-4">
                            @Html.TextBoxFor(m => m.fechaFin, new { @class = "form-control", @type = "date", @id = "fechaFin", @required = "required" })
                            <label for="fechaFin">Fecha de fin</label>
                        </div>

                        <!-- Botón de enviar -->
                        <button type="button"
                                class="btn btn-success w-100 rounded-pill py-2 fs-5 shadow-sm"
                                onclick="confirmarEnvio('¿Estás seguro de enviar la solicitud?', 'formSolicitud')">
                            <i class="fas fa-paper-plane me-2"></i> Enviar Solicitud
                        </button>
                    }

                    <!-- Mensaje de error -->
                    @if (!string.IsNullOrEmpty(ViewBag.MensajePantalla))
                    {
                        <div class="alert alert-warning alert-dismissible fade show mt-4" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.MensajePantalla
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                        </div>
                    }

                    <!-- Alerta de solicitud pendiente -->
                    @if (ViewBag.MostrarAlerta != null && (bool)ViewBag.MostrarAlerta)
                    {
                        <script>
                            document.addEventListener("DOMContentLoaded", function () {
                                Swal.fire({
                                    icon: 'warning',
                                    title: '¡Solicitud pendiente!',
                                    text: 'No puedes realizar una nueva solicitud mientras tienes una en estado pendiente.',
                                    confirmButtonText: 'Entendido',
                                    customClass: {
                                        confirmButton: 'btn btn-primary'
                                    },
                                    buttonsStyling: false
                                }).then(() => {
                                    window.location.href = '@Url.Action("Index", "Home")';
                                });
                            });
                        </script>
                    }
                </div>
            </div>
        </div>
    </div>
</div>


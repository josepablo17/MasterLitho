@model MasterLitho.Models.tVacaciones

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="fw-bold mb-0">Solicitud de Vacaciones</h3>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("SolicitarVacaciones", "SolicitudVacaciones"))
                    {
                        @Html.HiddenFor(m => m.idUsuario)

                        <!-- Mostrar días disponibles -->
                        <div class="mb-4">
                            <label for="diasDisponibles" class="form-label fw-semibold">Días Disponibles</label>
                            @Html.TextBoxFor(m => m.diasVacacionesDisponibles, new { @class = "form-control rounded-pill", @readonly = "readonly" })
                        </div>

                        <!-- Fecha de inicio -->
                        <div class="mb-4">
                            <label for="FechaInicio" class="form-label fw-semibold">Fecha de inicio</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar"></i></span>
                                @Html.TextBoxFor(m => m.fechaInicio, new { @class = "form-control rounded-end-pill", @type = "date", @required = "required" })
                            </div>
                        </div>

                        <!-- Fecha de fin -->
                        <div class="mb-4">
                            <label for="FechaFin" class="form-label fw-semibold">Fecha de fin</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-calendar"></i></span>
                                @Html.TextBoxFor(m => m.fechaFin, new { @class = "form-control rounded-end-pill", @type = "date", @required = "required" })
                            </div>
                        </div>

                        <!-- Comentario -->
                        <div class="mb-4">
                            <label for="Comentario" class="form-label fw-semibold">Comentario</label>
                            @Html.TextAreaFor(m => m.comentario, new { @class = "form-control rounded", @placeholder = "Añade un comentario (opcional)", rows = 3 })
                        </div>

                        <!-- Botón de envío -->
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fs-5">Enviar Solicitud</button>
                    }

                    <!-- Mensaje de error -->
                    @if (!string.IsNullOrEmpty(ViewBag.MensajePantalla))
                    {
                        <div class="alert alert-warning mt-3">
                            @ViewBag.MensajePantalla
                        </div>
                    }

                    <!-- Alerta de solicitud pendiente -->
                    @if (ViewBag.MostrarAlerta != null && (bool)ViewBag.MostrarAlerta)
                    {
                        <script>
                            Swal.fire({
                                icon: 'warning',
                                title: '¡Solicitud pendiente!',
                                text: 'No puedes realizar una nueva solicitud mientras tienes una en estado pendiente.',
                                confirmButtonText: 'Entendido',
                                customClass: {
                                    confirmButton: 'btn btn-primary'
                                },
                                buttonsStyling: false
                            }).then(() => {
                                window.location.href = '@Url.Action("Index", "Home")';
                            });
                        </script>
                    }
                </div>
            </div>
        </div>
    </div>
</div>



@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewBag.Title = "Consultar Saldo de Vacaciones";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-primary text-white text-center">
            <h2>Consultar Saldo de Vacaciones</h2>
        </div>
        <div class="card-body text-center">
            @if (ViewBag.SaldoVacaciones != null)
            {
                <div class="my-4">
                    <h3 class="text-success">Saldo de Vacaciones</h3>
                    <p class="fs-4">
                        Tienes disponibles:
                        <strong class="text-primary">@ViewBag.SaldoVacaciones días</strong>
                    </p>
                    <i class="bi bi-calendar-check text-success" style="font-size: 4rem;"></i>
                </div>
            }
            else if (ViewBag.MensajeError != null)
            {
                <div class="alert alert-danger my-4" role="alert">
                    <p class="fs-5">@ViewBag.MensajeError</p>
                </div>
            }

        </div>
    </div>
</div>

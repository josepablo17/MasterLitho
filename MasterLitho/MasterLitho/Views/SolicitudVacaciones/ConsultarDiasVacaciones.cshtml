@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Consultar Saldo de Vacaciones";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header text-white text-center py-4"
                     style="background: linear-gradient(135deg, #007bff, #004494);">
                    <h2 class="mb-0 fw-bold">📆 Consultar Saldo de Vacaciones</h2>
                </div>
                <div class="card-body text-center p-5">
                    @if (ViewBag.SaldoVacaciones != null)
                    {
                        <div class="mb-4">
                            <h3 class="text-success fw-bold">Saldo Disponible</h3>
                            <p class="fs-4 mt-2">
                                <strong class="text-primary display-4">@ViewBag.SaldoVacaciones</strong> días disponibles
                            </p>
                            <i class="bi bi-calendar-check text-success" style="font-size: 5rem;"></i>
                        </div>
                        <div class="mt-4">
                            <a href="@Url.Action("SolicitarVacaciones", "SolicitudVacaciones")"
                               class="btn btn-success btn-lg shadow-sm px-4 py-2">
                                <i class="bi bi-pencil-square me-2"></i> Solicitar Vacaciones
                            </a>
                        </div>
                    }
                    else if (ViewBag.MensajeError != null)
                    {
                        <div class="alert alert-danger my-4 fw-bold d-flex align-items-center justify-content-center p-3"
                             style="border-left: 5px solid #dc3545; border-radius: 8px;">
                            <i class="bi bi-exclamation-triangle me-2" style="font-size: 1.5rem;"></i> @ViewBag.MensajeError
                        </div>
                    }
                </div>
                <div class="card-footer text-center bg-light py-3">
                    <a href="@Url.Action("Index", "Home")" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left"></i> Volver al Inicio
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

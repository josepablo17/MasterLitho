@model List<MasterLitho.Models.tVacaciones>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .card {
        margin: auto;
        padding: 15px;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.05);
        border-radius: 12px;
    }

    .table-responsive {
        overflow-x: auto;
        min-height: 200px;
    }

    button[disabled] {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .acciones-columna {
        width: 1%;
        white-space: nowrap;
    }

</style>


<div class="container-fluid px-4 main-content">
    <div class="text-center mb-4">
        <h1 class="my-4 text-dark fw-bold">
            <i class="fas fa-plane-departure me-2 text-primary"></i> Gestión y Aprobación de Solicitudes de Vacaciones
        </h1>
    </div>

    <div class="card rounded shadow">
        <div class="card-body">
            <h5 class="text-primary fw-bold text-center mb-4">Lista de solicitudes</h5>

            <div class="table-responsive">
                <table id="solicitudesTable" class="table text-nowrap align-middle mb-0 w-100">
                    <thead>
                        <tr>
                            <th>Nombre usuario</th>
                            <th>Fecha de la solicitud</th>
                            <th>Fecha inicio</th>
                            <th>Fecha fin</th>
                            <th>Días solicitados</th>
                            <th>Estado</th>
                            <th class="acciones-columna">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            bool estadoFinalizado = item.nombreEstado == "Aceptado" || item.nombreEstado == "Rechazado";

                            <tr data-id="@item.idSolicitud">
                                <td>@item.nombreUsuario</td>
                                <td>@item.fechaSolicitud.ToString("dd-MM-yyyy")</td>
                                <td>@item.fechaInicio.ToString("dd-MM-yyyy")</td>
                                <td>@item.fechaFin.ToString("dd-MM-yyyy")</td>
                                <td>@item.diasSolicitados</td>
                                <td>
                                    @if (item.nombreEstado == "Pendiente")
                                    {
                                        <span class="badge bg-warning text-dark">Pendiente</span>
                                    }
                                    else if (item.nombreEstado == "Aceptado")
                                    {
                                        <span class="badge bg-success">Aceptado</span>
                                    }
                                    else if (item.nombreEstado == "Rechazado")
                                    {
                                        <span class="badge bg-danger">Rechazado</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.nombreEstado</span>
                                    }
                                </td>
                                <td class="acciones-columna">
                                    <button class="btn btn-primary btn-sm cambiar-estado-btn"
                                            onclick="abrirModal(@item.idSolicitud)"
                                            @(estadoFinalizado ? "disabled" : "")>
                                        Cambiar Estado
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="cambiarEstadoModal" tabindex="-1" aria-labelledby="cambiarEstadoModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cambiarEstadoModalLabel">Cambiar Estado de Solicitud</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="estadoForm">
                    <input type="hidden" id="solicitudId" name="idSolicitud" />
                    <div class="mb-3">
                        <label for="nuevoEstado" class="form-label">Nuevo Estado</label>
                        <select id="nuevoEstado" name="estado" class="form-select">
                            @foreach (var estado in ViewBag.listaEstados as List<SelectListItem>)
                            {
                                <option value="@estado.Value">@estado.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="comentario" class="form-label">Comentario</label>
                        <textarea id="comentario" name="comentario" class="form-control" rows="3" placeholder="Ingrese un comentario"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarEstado()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        inicializarDataTable('#solicitudesTable');
    });

    function abrirModal(id) {
        $('#solicitudId').val(id);
        $('#cambiarEstadoModal').modal('show');
    }

   function guardarEstado() {
    const idSolicitud = $('#solicitudId').val();
    const idEstado = $('#nuevoEstado').val();
    const comentario = $('#comentario').val();

    if (!idEstado) {
        alertaError("Por favor, seleccione un estado válido.");
        return;
    }

    confirmarEnvio("¿Seguro que deseas cambiar el estado de la solicitud?", null, function () {
        $.ajax({
            url: '@Url.Action("EditarEstado", "SolicitudVacaciones")',
            type: 'POST',
            data: {
                idSolicitud: idSolicitud,
                idEstado: idEstado,
                comentario: comentario
            },
            success: function (response) {
                if (response.success) {
                    // Deshabilitar el botón si el estado es "Aprobado" o "Rechazado"
                    if (idEstado === "Aceptado" || idEstado === "Rechazado") {
                        $('tr[data-id="' + idSolicitud + '"] .cambiar-estado-btn').prop('disabled', true);
                    }
                    alertaExito("El estado se actualizó correctamente.");
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                } else {
                    alertaError("Hubo un problema al actualizar el estado.");
                }
            },
            error: function () {
                alertaError("Ocurrió un error al intentar actualizar el estado.");
            }
        });
    });
}
</script>

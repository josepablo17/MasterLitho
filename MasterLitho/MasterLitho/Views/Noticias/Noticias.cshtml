@model IEnumerable<MasterLitho.Models.NOTICIAS>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Noticias";
}

<style>
    .card {
        margin: auto;
        padding: 15px;
        height: auto;
        max-width: 100%;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .card-body {
        padding: 10px 20px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    body, html {
        overflow-x: hidden;
    }
    .acciones-columna {
        width: 100px;
        white-space: nowrap;
    }
</style>


<div class="container-fluid px-4">
    <div class="text-center mb-4">
        <h1 class="my-4 text-dark fw-bold">
            <i class="fas fa-newspaper text-primary me-2"></i> Gestión de Noticias
        </h1>
    </div>

    <div class="card rounded shadow">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                <h5 class="text-primary fw-bold mb-0">Lista de noticias</h5>
                <a href="@Url.Action("CrearNoticia", "Noticias")"
                   class="btn btn-success btn-lg rounded-pill shadow-sm mt-2 mt-md-0">
                    <i class="fas fa-plus-circle me-1"></i> Crear nueva noticia
                </a>
            </div>

            <div class="table-responsive">
                <table id="solicitudesTable" class="table table-hover table-striped text-nowrap align-middle mb-0 w-100">
                    <thead class="table-dark">
                        <tr>
                            <th>Título de la noticia</th>
                            <th>Fecha publicación</th>
                            <th>Imagen</th>
                            <th class="acciones-columna">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var noticia in Model)
                        {
                            <tr>
                                <td>@noticia.TITULO</td>
                                <td>@noticia.FECHA_PUBLICACION.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(noticia.IMAGEN_RUTA))
                                    {
                                        <img src="@Url.Content(noticia.IMAGEN_RUTA)" alt="Imagen Noticia" width="100" class="img-thumbnail" />
                                    }
                                    else
                                    {
                                        <span>No disponible</span>
                                    }
                                </td>
                                <td class="acciones-columna">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-primary"
                                           href="@Url.Action("EditarNoticia", "Noticias", new { id = noticia.ID_NOTICIA })"
                                           data-bs-toggle="tooltip" title="Editar Noticia">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a class="btn btn-danger"
                                           href="@Url.Action("EliminarNoticia", "Noticias", new { id = noticia.ID_NOTICIA })"
                                           data-bs-toggle="tooltip" title="Eliminar Noticia">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        inicializarDataTable('#solicitudesTable');
    });
</script>

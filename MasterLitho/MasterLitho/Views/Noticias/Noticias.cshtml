@model IEnumerable<MasterLitho.Models.NOTICIAS>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Noticias";
}

<h2>Lista de Noticias</h2>

<!-- Solo los administradores pueden crear noticias -->
@if (Session["rolUsuario"] != null && Session["rolUsuario"].ToString() == "1")
{
    <a href="@Url.Action("CrearNoticia", "Noticias")" class="btn btn-success mb-3">Crear Noticia</a>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Descripción</th>
            <th>Fecha Publicación</th>
            <th>Imagen</th>
            @if (Session["rolUsuario"] != null && Session["rolUsuario"].ToString() == "1")
            {
                <th>Acciones</th>
 <!-- Solo los administradores ven las acciones -->
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var noticia in Model)
        {
            <tr>
                <td>@noticia.ID_NOTICIA</td>
                <td>@noticia.TITULO</td>
                <td>@noticia.DESCRIPCION</td>
                <td>@noticia.FECHA_PUBLICACION.ToString("yyyy-MM-dd HH:mm")</td>
                <td>
                    @if (!string.IsNullOrEmpty(noticia.IMAGEN_RUTA))
                    {
                        <img src="@Url.Content(noticia.IMAGEN_RUTA)" alt="Imagen Noticia" width="100" />
                    }
                    else
                    {
                        <span>No disponible</span>
                    }
                </td>

                @if (Session["rolUsuario"] != null && Session["rolUsuario"].ToString() == "1")
                {
                    <td>
                        <a href="@Url.Action("EditarNoticia", "Noticias", new { id = noticia.ID_NOTICIA })" class="btn btn-warning btn-sm">Editar</a>
                        <a href="@Url.Action("EliminarNoticia", "Noticias", new { id = noticia.ID_NOTICIA })" class="btn btn-danger btn-sm" onclick="return confirm('¿Estás seguro de eliminar esta noticia?');">Eliminar</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

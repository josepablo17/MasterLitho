@model IEnumerable<MasterLitho.Models.NOTICIAS>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Noticias";
}

<style>
    .card {
        margin: auto;
        padding: 15px;
        height: auto;
        max-width: 100%;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .card-body {
        padding: 10px 20px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    body, html {
        overflow-x: hidden;
    }

    .acciones-columna {
        width: 100px;
        white-space: nowrap;
    }

    .miniatura-noticia {
        width: 150px;
        height: 150px;
        object-fit: cover;
        object-position: center;
    }
</style>


<div class="container-fluid px-4">
    <div class="text-center mb-4">
        <h1 class="my-4 text-dark fw-bold">
            <i class="fas fa-newspaper text-primary me-2"></i> Gestión de Noticias
        </h1>
    </div>

    <div class="card rounded shadow">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                <h5 class="text-primary fw-bold mb-0">Lista de noticias</h5>
                <a href="@Url.Action("CrearNoticia", "Noticias")"
                   class="btn btn-success btn-lg rounded-pill shadow-sm mt-2 mt-md-0">
                    <i class="fas fa-plus-circle me-1"></i> Crear nueva noticia
                </a>
            </div>

            <div class="table-responsive">
                <table id="solicitudesTable" class="table text-nowrap align-middle mb-0 w-100">
                    <thead>
                        <tr>
                            <th>Título de la noticia</th>
                            <th>Fecha publicación</th>
                            <th class="imagen-columna">Imagen</th>
                            <th class="acciones-columna">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var noticia in Model)
                        {
                            <tr>
                                <td>@noticia.TITULO</td>
                                <td>@noticia.FECHA_PUBLICACION.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="imagen-columna">
                                    @if (!string.IsNullOrEmpty(noticia.IMAGEN_RUTA))
                                    {
                                        <img src="@Url.Content(noticia.IMAGEN_RUTA)" alt="Imagen Noticia" class="img-thumbnail miniatura-noticia" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">No disponible</span>
                                    }
                                </td>
                                <td class="acciones-columna">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-primary btn-sm"
                                           href="@Url.Action("EditarNoticia", "Noticias", new { id = noticia.ID_NOTICIA })"
                                           data-bs-toggle="tooltip" title="Editar Noticia">
                                            <i class="fas fa-pen"></i>
                                        </a>

                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                onclick="confirmarEliminacion(@noticia.ID_NOTICIA)"
                                                data-bs-toggle="tooltip" title="Eliminar Noticia">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        inicializarDataTable('#solicitudesTable');
    });

    function confirmarEliminacion(idNoticia) {
        Swal.fire({
            title: '¿Estás seguro?',
            text: "Esta acción eliminará la noticia de forma permanente.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '/Noticias/EliminarNoticia/' + idNoticia;
            }
        });
    }
</script>


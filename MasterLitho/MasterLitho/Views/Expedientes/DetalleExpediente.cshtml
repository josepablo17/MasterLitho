@model IEnumerable<MasterLitho.Models.DOCUMENTO_EXPEDIENTE>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Documentos del Expediente";
    var expediente = ViewBag.Expediente as MasterLitho.Models.EXPEDIENTE;
}

<div id="content-wrapper" class="container">
    <div id="content">
        <h1 class="my-4">Gestión de documentos</h1>

        <div class="container-fluid">
            <div class="card shadow-lg rounded">
                <div class="card-body">
                    <!-- Ahora mostramos el NOMBRE_EXPEDIENTE -->
                    <h5 class="card-title text-center text-primary font-weight-bold mb-4">
                        Expediente: @(expediente == null ? "NULL" : expediente.NOMBRE_EXPEDIENTE)
                    </h5>

                    <p>
                        <strong>Usuario:</strong>
                        @(expediente == null || expediente.USUARIO == null ? "NULL" : expediente.USUARIO.NOMBRE_USUARIO)
                        (@(expediente == null || expediente.USUARIO == null ? "NULL" : expediente.USUARIO.IDENTIFICACION))
                    </p>
                    <p>
                        <strong>Correo:</strong>
                        @(expediente == null || expediente.USUARIO == null ? "NULL" : expediente.USUARIO.CORREO_USUARIO)
                    </p>
                    <p>
                        <strong>Fecha Creación:</strong>
                        @(expediente == null ? "NULL" : expediente.FECHA_CREACION.ToString("yyyy-MM-dd HH:mm"))
                    </p>

                    <hr />
                    <h5 class="card-title text-center text-primary font-weight-bold mb-4">Documentos</h5>
                    <div class="table-responsive">
                        <table id="documentosTable" class="table table-hover table-striped text-nowrap align-middle mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>Nombre Documento</th>
                                    <th>Tipo</th>
                                    <th>Fecha Carga</th>
                                    <th>Última Actualización</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model)
                                {
                                    <tr>
                                        <td>@doc.NOMBRE_DOCUMENTO</td>
                                        <td>@doc.TIPO_DOCUMENTO</td>
                                        <td>@doc.FECHA_CARGA.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            @if (doc.FECHA_ACTUALIZACION.HasValue)
                                            {
                                                @doc.FECHA_ACTUALIZACION.Value.ToString("yyyy-MM-dd HH:mm")
                                            }
                                            else
                                            {
                                                <span>No disponible</span>
                                            }
                                        </td>
                                        <td>
                                            <a class="btn" href="@Url.Action("EditarDocumento", "Expedientes", new { idDocumento = doc.ID_DOCUMENTO })">
                                                <i class="fas fa-pencil"></i>
                                            </a>
                                            <a class="btn" href="@Url.Action("EliminarDocumento", "Expedientes", new { idDocumento = doc.ID_DOCUMENTO })"
                                               onclick="return confirm('¿Seguro que deseas eliminar este documento?');">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                            <a class="btn" href="@Url.Action("DescargarDocumento", "Expedientes", new { idDocumento = doc.ID_DOCUMENTO })">
                                                <i class="fas fa-download"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <a href="@Url.Action("AgregarDocumento", "Expedientes", new { id = expediente == null ? 0 : expediente.ID_EXPEDIENTE })"
                   class="btn btn-outline-primary">
                    + Agregar documento
                </a>

                <a href="@Url.Action("CrearDocumento", "Documentos", new { idExpediente = expediente.ID_EXPEDIENTE })"
                   class="btn btn-success">
                    Crear Documento
                </a>


                <a href="@Url.Action("IndexExpedientes", "Expedientes")" class="btn btn-secondary">
                    Volver a Expedientes
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        inicializarDataTable('#documentosTable');
    });
</script>

@{
    Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";

}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recepción de Documentos y Consulta de Expediente</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

    <div class="container mt-5">
        <h2 class="text-center">Recepción de Documentos y Consulta de Expediente</h2>

        <!-- Formulario para Solicitar Documento -->
        <div class="card mb-4">
            <div class="card-body">
                <h4 class="card-title">Recibir Documentos</h4>
                <form id="document-receive-form">
                    <div class="mb-3">
                        <label for="document-name" class="form-label">Nombre del Documento</label>
                        <input type="text" class="form-control" id="document-name" placeholder="Ingresa el nombre del documento" required>
                    </div>
                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">Recibir Documento</button>
                    </div>
                </form>
                <div id="document-received-notification" class="alert alert-info mt-3 d-none">
                    <strong>Notificación:</strong> El documento ha sido recibido exitosamente.
                </div>
            </div>
        </div>

        <div id="message" class="alert d-none"></div>

       
        <div class="card mb-4">
            <div class="card-body">
                <h4 class="card-title">Estado del Documento</h4>
                <div id="document-status">
                    <div class="alert alert-success" role="alert" id="status-received" style="display: none;">
                        <strong>Estado:</strong> Documento recibido exitosamente.
                    </div>
                    <div class="alert alert-warning" role="alert" id="status-not-available" style="display: none;">
                        <strong>Estado:</strong> Documento eliminado o no disponible.
                    </div>
                </div>
            </div>
        </div>

        <hr>

        <div class="card mb-4">
            <div class="card-body">
                <h4 class="card-title">Consultar Expediente Personal</h4>
                <form id="expediente-form">
                    <div class="mb-3">
                        <button type="submit" class="btn btn-success">Consultar Expediente</button>
                    </div>
                </form>
                <div id="expediente-status" class="alert alert-success" role="alert" style="display: none;">
                    <strong>Consulta Exitosa:</strong> Los documentos del expediente están disponibles.
                </div>
                <div id="expediente-documents" class="list-group mt-3">
                  
                    <a href="#" class="list-group-item list-group-item-action">Contrato Laboral - Descargar</a>
                    <a href="#" class="list-group-item list-group-item-action">Adendo 1 - Descargar</a>
                    <a href="#" class="list-group-item list-group-item-action">Adendo 2 - Descargar</a>
                </div>
            </div>
        </div>

    </div>

    <script>
      
        document.getElementById('document-receive-form').addEventListener('submit', function (event) {
            event.preventDefault();

            let documentName = document.getElementById('document-name').value;

            if (documentName) {
          
                let documentReceived = true;

             
                if (documentReceived) {
                    showStatus('Recibido');
                    showMessage('Documento recibido exitosamente', 'success');
                } else {
                    showStatus('No disponible');
                    showMessage('El documento ha sido eliminado o no está disponible', 'warning');
                }
            } else {
                showMessage('Por favor, ingresa el nombre del documento', 'danger');
            }
        });

       
        function showStatus(status) {
            document.getElementById('status-received').style.display = 'none';
            document.getElementById('status-not-available').style.display = 'none';

            if (status === 'Recibido') {
                document.getElementById('status-received').style.display = 'block';
            } else if (status === 'No disponible') {
                document.getElementById('status-not-available').style.display = 'block';
            }
        }


        function showMessage(message, type) {
            const messageDiv = document.getElementById('message');
            messageDiv.className = `alert alert-${type}`;
            messageDiv.innerHTML = message;
            messageDiv.classList.remove('d-none');
        }

        setTimeout(() => {
            document.getElementById('document-received-notification').classList.remove('d-none');
        }, 5000); 

     
        document.getElementById('expediente-form').addEventListener('submit', function (event) {
            event.preventDefault();

           
            document.getElementById('expediente-status').style.display = 'block';
            document.getElementById('expediente-documents').style.display = 'block';
        });
    </script>

</body>
</html>

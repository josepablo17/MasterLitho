@model MasterLitho.Models.tDocumentoExpediente

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Agregar Documento";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0 text-center">Agregar Documento</h2>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("AgregarDocumento", "Expedientes", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.idExpediente)

                <div class="mb-3">
                    <label class="form-label">Tipo de Documento</label>
                    @Html.TextBoxFor(m => m.tipoDocumento, new
                    {
                        @class = "form-control",
                        placeholder = "Ej: Contrato, Adendo...",
                        required = "required"
                    })
                </div>

                <div class="mb-3">
                    <label class="form-label">Archivo</label>
                    <input type="file" name="archivo" class="form-control" required />
                </div>

                <div class="text-end">
                    <a href="@Url.Action("DetalleExpediente", "Expedientes", new { id = Model.idExpediente })" class="btn btn-secondary">
                        Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload me-1"></i> Subir
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@model MasterLitho.Models.tEnvioDocumento

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Enviar Documento por Correo";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white text-center">
            <h2 class="mb-0">Enviar Documento</h2>
        </div>

        <div class="card-body">
            @using (Html.BeginForm("EnviarDocCorreo", "Expedientes", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.idUsuario)

                <div class="mb-3">
                    <label class="form-label">Correo del destinatario</label>
                    <input type="email" class="form-control" value="@Model.correoUsuario" readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Asunto</label>
                    @Html.TextBoxFor(m => m.titulo, new { @class = "form-control", placeholder = "Ingrese el asunto del correo", required = "required" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Descripción</label>
                    @Html.TextAreaFor(m => m.descripcion, 4, 50, new { @class = "form-control", placeholder = "Ingrese un mensaje para el usuario", required = "required" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Adjuntar Documento</label>
                    <input type="file" name="archivo" class="form-control" required />
                </div>

                <div class="text-end">
                    <a href="@Url.Action("IndexExpedientes", "Expedientes")" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Enviar</button>
                </div>
            }
        </div>
    </div>
</div>

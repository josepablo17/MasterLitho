@model MasterLitho.Models.tDocumentoExpediente

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Editar Documento";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0 text-center">Editar Documento</h2>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("EditarDocumento", "Expedientes", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.idDocumento)
                @Html.HiddenFor(model => model.idExpediente)

                <!-- Muestra información actual -->
                <div class="mb-3">
                    <label class="form-label">Nombre Actual</label>
                    <p>@Model.nombreDocumento</p>
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo de Documento</label>
                    @Html.TextBoxFor(model => model.tipoDocumento, new { @class = "form-control", placeholder = "Ej: Contrato, Permiso..." })
                </div>

                <div class="mb-3">
                    <label class="form-label">Subir Nuevo Archivo (Opcional)</label>
                    <input type="file" name="nuevoArchivo" class="form-control" />
                </div>

                <div class="text-end">
                    <a href="@Url.Action("DetalleExpediente", "Expedientes", new { id = Model.idExpediente })"
                       class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            }
        </div>
    </div>
</div>

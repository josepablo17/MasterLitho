@model MasterLitho.Models.tExpediente

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Crear Expediente";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0 text-center">Crear Expediente</h2>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("CrearExpediente", "Expedientes", FormMethod.Post, new { @id = "formCrearExpediente" }))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Seleccione el Usuario</label>
                    @Html.DropDownListFor(m => m.idUsuario,
                        ViewBag.ListaEmpleados as List<SelectListItem>,
                        new { @class = "form-control", required = "required" })
                </div>

                <div class="mb-3">
                    <label class="form-label">Nombre del Expediente</label>
                    @Html.TextBoxFor(m => m.nombreExpediente,
                        new { @class = "form-control", placeholder = "Ingrese un nombre descriptivo para el expediente", required = "required" })
                </div>

                <div class="text-end">
                    <a href="@Url.Action("IndexExpedientes", "Expedientes")" class="btn btn-secondary">Cancelar</a>
                    <button type="button" class="btn btn-primary" id="btnCrearExpediente">Guardar</button>
                </div>
            }
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Styles/FuncionesJS/FuncionesSweetAlert.js"></script>
<script>
    document.getElementById("btnCrearExpediente").addEventListener("click", function () {
        confirmarEnvio("¿Desea crear este expediente?", "formCrearExpediente");
        });
</script>

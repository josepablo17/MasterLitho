@model List<MasterLitho.Models.tExpediente>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Expedientes";
}

<div class="container mt-4 mb-5">
    <i class="fas fa-folder-open text-primary me-2"></i> Gestión de Expedientes
    <h2 class="text-center text-dark fw-bold mb-4">
    </h2>

    <div class="d-flex justify-content-end mb-3">
        <a href="@Url.Action("CrearExpediente", "Expedientes")"
           class="btn btn-success btn-lg rounded-pill shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Crear nuevo expediente
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-lg rounded">
            <div class="card-body">
                <h5 class="card-title text-center text-primary fw-bold mb-4">Lista de expedientes</h5>

                <div class="table-responsive">
                    <table id="expedientesTable" class="table table-hover table-striped align-middle w-100">
                        <thead class="table-dark text-center">
                            <tr>
                                <th>Nombre</th>
                                <th>Usuario</th>
                                <th>Identificación</th>
                                <th>Fecha Creación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exp in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrEmpty(exp.nombreExpediente))
                                        {
                                            @exp.nombreExpediente
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Sin nombre</span>
                                        }
                                    </td>
                                    <td>   
                                     @exp.nombreUsuario
                                    </td>
                                    <td>
                                        @exp.identificacion
                                    </td>
                                    <td class="text-nowrap">@exp.fechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">

                                            <a href="@Url.Action("DetalleExpediente", "Expedientes", new { id = exp.idExpediente })"
                                               class="btn btn-primary"
                                               title="Ver detalles" data-bs-toggle="tooltip">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-danger"
                                                    onclick="confirmDelete(@exp.idExpediente, '@(exp.nombreExpediente ?? "Sin nombre")')"
                                                    title="Eliminar expediente" data-bs-toggle="tooltip">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>

                                            <a href="@Url.Action("EnviarDocCorreo", "Expedientes", new { idUsuario = exp.idUsuario })"
                                               class="btn btn-success"
                                               title="Enviar documento por correo" data-bs-toggle="tooltip">
                                                <i class="fas fa-paper-plane"></i>
                                            </a>
                                        </div>

                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>    
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info text-center shadow-sm mt-5">
            <i class="fas fa-info-circle me-2"></i> No hay expedientes registrados actualmente.
        </div>
    }
</div>


<!-- Modal de confirmación para eliminar expediente -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("EliminarExpedienteConfirmed", "Expedientes", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteExpedienteId" name="id" value="" />
                    <p>¿Está seguro que desea eliminar el expediente <strong id="deleteExpedienteNombre"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            }
        </div>
    </div>
</div>


<script>
    // Función que se invoca al presionar el botón de eliminar expediente
    function confirmDelete(expedienteId, expedienteNombre) {
        // Asigna el ID en el input oculto del modal
        document.getElementById("deleteExpedienteId").value = expedienteId;
        // Muestra el nombre del expediente en el modal
        document.getElementById("deleteExpedienteNombre").innerText = expedienteNombre;
        // Muestra el modal usando Bootstrap (asegúrate de tener jQuery y Bootstrap JS cargados)
        $('#deleteModal').modal('show');
    }
</script>

<script>
    $(document).ready(function () {
        inicializarDataTable('#expedientesTable');
    });
</script>

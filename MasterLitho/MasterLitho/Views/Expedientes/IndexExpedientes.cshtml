@model List<MasterLitho.Models.tExpediente>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Expedientes";
}

<style>

    .card {
        margin: auto;
        padding: 15px;
        height: auto;
        max-width: 100%;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }

    .card-body {
        padding: 10px 20px;
    }

    .table-responsive {
        overflow-x: auto;
    }

    body, html {
        overflow-x: hidden;
    }
    .acciones-columna {
        width: 1%;
        white-space: nowrap;
    }
</style>


<div class="container-fluid px-4">
    <div class="text-center mb-4">
        <h1 class="my-4 text-dark fw-bold">
            <i class="fas fa-folder-open text-primary me-2"></i> Gestión de Expedientes
        </h1>
    </div>

    <div class="container-fluid px-4">
        <div class="text-center mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap">
                <h5 class="text-primary fw-bold mb-0">Lista de expedientes</h5>
                <a href="@Url.Action("CrearExpediente", "Expedientes")"
                   class="btn btn-success btn-lg rounded-pill shadow-sm mt-2 mt-md-0">
                    <i class="fas fa-plus-circle me-1"></i> Crear nuevo expediente
                </a>
            </div>

        </div>



        @if (Model != null && Model.Any())
        {
            <div class="card rounded shadow">
                <div class="card-body">

                    <div class="table-responsive">
                        <table id="expedientesTable" class="table text-nowrap align-middle mb-0 w-100">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Usuario</th>
                                    <th>Identificación</th>
                                    <th>Fecha Creación</th>
                                    <th class="acciones-columna">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exp in Model)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(exp.nombreExpediente))
                                            {
                                                @exp.nombreExpediente
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">Sin nombre</span>
                                            }
                                        </td>
                                        <td>@exp.nombreUsuario</td>
                                        <td>@exp.identificacion</td>
                                        <td>@exp.fechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td class="acciones-columna">
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("DetalleExpediente", "Expedientes", new { id = exp.idExpediente })"
                                                   class="btn btn-primary btn-sm"
                                                   title="Ver detalles" data-bs-toggle="tooltip">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        onclick="confirmarEliminacionExpediente(@exp.idExpediente, '@(exp.nombreExpediente ?? "Sin nombre")')"
                                                        title="Eliminar">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>

                                                <!--<a href="@Url.Action("EnviarDocCorreo", "Expedientes", new { idUsuario = exp.idUsuario })"
                                                   class="btn btn-success btn-sm"
                                                   title="Enviar documento por correo" data-bs-toggle="tooltip">
                                                    <i class="fas fa-paper-plane"></i>
                                                </a> -->
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center shadow-sm mt-5">
                <i class="fas fa-info-circle me-2"></i> No hay expedientes registrados actualmente.
            </div>
        }
    </div>

    <!-- Modal de confirmación para eliminar expediente -->
    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                @using (Html.BeginForm("EliminarExpedienteConfirmed", "Expedientes", FormMethod.Post, new { id = "formEliminarExpediente" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title" id="deleteModalLabel">Confirmar Eliminación</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="deleteExpedienteId" name="id" value="" />
                        <p>¿Está seguro que desea eliminar el expediente <strong id="deleteExpedienteNombre"></strong>?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">Eliminar</button>
                    </div>
                }
            </div>
        </div>
    </div>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
      function confirmarEliminacionExpediente(idExpediente, nombreExpediente) {
          Swal.fire({
              title: '¿Estás seguro?',
              html: `El expediente <strong>${nombreExpediente}</strong> se eliminará permanentemente.`,
              icon: 'warning',
              showCancelButton: true,
              confirmButtonColor: '#d33',
              cancelButtonColor: '#6c757d',
              confirmButtonText: 'Sí, eliminar',
              cancelButtonText: 'Cancelar'
          }).then((result) => {
              if (result.isConfirmed) {
                  document.getElementById("deleteExpedienteId").value = idExpediente;
                  document.getElementById("formEliminarExpediente").submit();
              }
          });
      }

</script>


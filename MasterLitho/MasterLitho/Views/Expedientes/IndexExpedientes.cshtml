@model IEnumerable<MasterLitho.Models.EXPEDIENTE>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Expedientes";
}

<div id="content-wrapper" class="container">
    <div id="content">
        <h1 class="my-4">Gestión de expedientes</h1>
        <div class="container-fluid">
            <div class="card shadow-lg rounded">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary font-weight-bold mb-4">
                        Lista de expedientes
                    </h5>
                    <div class="table-responsive">
                        <table id="expedientesTable" class="table table-hover table-striped text-nowrap align-middle mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID Expediente</th>
                                    <th>Nombre Expediente</th>
                                    <th>Nombre Usuario</th>
                                    <th>Identificación</th>
                                    <th>Fecha Creación</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var exp in Model)
                                {
                                    <tr>
                                        <td>@exp.ID_EXPEDIENTE</td>
                                        <td>@(exp.NOMBRE_EXPEDIENTE ?? "Sin nombre")</td>
                                        <td>@(exp.USUARIO == null ? "NULL" : exp.USUARIO.NOMBRE_USUARIO)</td>
                                        <td>@(exp.USUARIO == null ? "NULL" : exp.USUARIO.IDENTIFICACION)</td>
                                        <td>@exp.FECHA_CREACION.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>
                                            <!-- Botón para ver detalle (documentos) -->
                                            <a class="btn" href="@Url.Action("DetalleExpediente", "Expedientes", new { id = exp.ID_EXPEDIENTE })">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <!-- Botón para eliminar expediente que llama a la función confirmDelete -->
                                            <button type="button" class="btn" onclick="confirmDelete(@exp.ID_EXPEDIENTE, '@(exp.NOMBRE_EXPEDIENTE ?? "Sin nombre")')">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-between mt-3">
                <a href="@Url.Action("CrearExpediente", "Expedientes")" class="btn btn-outline-primary">
                    + Crear expediente
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación para eliminar expediente -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("EliminarExpedienteConfirmed", "Expedientes", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteExpedienteId" name="id" value="" />
                    <p>¿Está seguro que desea eliminar el expediente <strong id="deleteExpedienteNombre"></strong>?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            }
        </div>
    </div>
</div>


<script>
    // Función que se invoca al presionar el botón de eliminar expediente
    function confirmDelete(expedienteId, expedienteNombre) {
        // Asigna el ID en el input oculto del modal
        document.getElementById("deleteExpedienteId").value = expedienteId;
        // Muestra el nombre del expediente en el modal
        document.getElementById("deleteExpedienteNombre").innerText = expedienteNombre;
        // Muestra el modal usando Bootstrap (asegúrate de tener jQuery y Bootstrap JS cargados)
        $('#deleteModal').modal('show');
    }
</script>

<script>
    $(document).ready(function () {
        inicializarDataTable('#expedientesTable');
    });
</script>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="content-wrapper" class="container">
    <div id="content">
        <h1 class="my-4">Consulta empleados</h1>
        <div class="container mb-4">
            <div class="d-flex justify-content-start">

            </div>
        </div>
        <div class="container-fluid">
            <div class="card shadow-lg rounded">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary font-weight-bold mb-4">Empleados</h5>
                    <div class="table-responsive">
                        <table id="solicitudesTable" class="table table-hover table-striped text-nowrap align-middle mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre usuario</th>
                                    <th>Dias de vacaciones</th>
                                    <th>Fecha de contratacion</th>
                                    <th>Departamento</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.ID_EMPLEADO</td>
                                        <td>@item.NOMBRE_USUARIO</td>
                                        <td>@item.DIAS_VACACIONES_DISPONIBLES</td>
                                        <td>@item.FECHA_CONTRATACION</td>
                                        <td>@item.NOMBRE_DEPARTAMENTO</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Script para inicializar DataTables -->
<script>
    $(document).ready(function () {
        inicializarDataTable('#solicitudesTable');
    });
</script>

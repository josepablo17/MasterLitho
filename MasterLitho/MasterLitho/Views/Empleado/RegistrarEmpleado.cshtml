@model MasterLitho.Models.tEmpleado

<div class="page-wrapper d-flex align-items-start justify-content-center min-vh-100" style="background-color: #f9f9f9; padding-top: 5vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 col-lg-12">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <a href="@Url.Action("Index", "Home")">
                                <img src="~/Styles/img/martelithocr-logo (1).png" alt="Logo" class="img-fluid" style="width: 120px;">
                            </a>
                        </div>
                        <h4 class="card-title fw-bold text-primary text-center mb-4">
                            <i class="fas fa-user-edit me-2"></i> Registrar Empleado
                        </h4>

                        @if (ViewBag.MensajePantalla != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                <i class="fas fa-exclamation-circle"></i> @ViewBag.MensajePantalla
                            </div>
                        }

                        @using (Html.BeginForm("RegistrarEmpleado", "Empleado", new { idUsuario = Model.ID_USUARIO }, FormMethod.Post))
                        {
                            @Html.Hidden("idUsuario", Model.ID_USUARIO)

                            <div class="mb-3">
                                <label class="form-label fw-semibold"><i class="fas fa-id-card me-2"></i> Fecha de contratacion</label>
                                @Html.TextBoxFor(m => m.FECHA_CONTRATACION, new { @class = "form-control border-primary", @type = "date", @placeholder = "Ingrese la fecha de contratación" })
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold"><i class="fas fa-envelope me-2"></i> Departamento</label>
                                @Html.DropDownListFor(m => m.ID_DEPARTAMENTO, ViewBag.Departamentos as List<SelectListItem>, new { @class = "form-control" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold"><i class="fas fa-id-card me-2"></i>Salario</label>
                                @Html.TextBoxFor(m => m.SALARIO, new { @class = "form-control border-primary", @type = "number", @placeholder = "Ingrese el salario bruto del empleado" })
                            </div>

                            <div class="d-grid gap-3">
                                <button type="submit" class="btn btn-primary btn-lg shadow">
                                    <i class="fas fa-save me-2"></i> Registrar Empleado
                                </button>

                                <a class="nav-link btn btn-secondary btn-lg shadow" href="@Url.Action("GestionUsuarios", "Usuarios")">
                                    <span>Volver</span>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

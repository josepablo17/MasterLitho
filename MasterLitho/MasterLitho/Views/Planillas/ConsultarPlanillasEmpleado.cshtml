@model List<MasterLitho.Models.tPlanilla>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container mt-4 mb-5">
    <h2 class="text-center text-dark fw-bold mb-4">
        <i class="fas fa-money-check-alt text-primary me-2"></i> Mis Planillas
    </h2>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var planilla in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-header bg-light d-flex justify-content-between">
                            <span class="fw-semibold"><i class="fas fa-calendar-check me-1"></i> Pago: @planilla.fechaPago.ToShortDateString()</span>
                            <span class="badge bg-primary">₡@planilla.salarioNeto.ToString("N2")</span>
                        </div>
                        <div class="card-body">
                            <p class="mb-2"><strong>Nombre:</strong> @planilla.nombreEmpleado @planilla.apellidoEmpleado</p>
                            <p class="mb-2"><strong>Fecha de contratación:</strong> @planilla.fechaContratacion.ToShortDateString()</p>
                            <p class="mb-2"><strong>Fecha de creación:</strong> @planilla.fechaCreacion.ToShortDateString()</p>

                            <div class="d-flex justify-content-between mt-3">
                                <a href="@Url.Action("DetallePlanilla", "Planillas", new { q = planilla.idPlanilla })"
                                   class="btn btn-outline-info btn-sm">
                                    <i class="fas fa-eye me-1"></i> Ver Detalles
                                </a>
                                <a href="@Url.Action("PrintDetallePlanilla", "Planillas", new { q = planilla.idPlanilla })"
                                   class="btn btn-danger btn-sm text-white"
                                   title="Descargar esta planilla como archivo PDF">
                                    <i class="fas fa-file-pdf me-1"></i> Descargar PDF
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info text-center mt-4 shadow-sm">
            <i class="fas fa-info-circle me-2"></i>
            No tienes planillas registradas todavía.
        </div>
    }
</div>




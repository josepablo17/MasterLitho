@model MasterLitho.Models.tPlanilla

@{
    ViewBag.Title = "CrearPlanilla";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="fw-bold mb-0">Solicitud de Vacaciones</h3>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("CrearPlanilla", "Planillas"))
                    {
                        @Html.HiddenFor(m => m.idEmpleado)

                        <div class="form-group mb-4">
                            <label for="Empleado" class="form-label fw-bold">Empleado</label>
                            @Html.DropDownListFor(m => m.idEmpleado, ViewBag.listaEmpleados as List<SelectListItem>, new { @class = "form-control", id = "empleadoDropdown" })
                        </div>

                        <div class="mb-4">
                            <label for="Fecha_Pago" class="form-label">Fecha de pago</label>
                            @Html.TextBoxFor(m => m.fechaPago, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })
                        </div>

                        <div class="mb-4">
                            <label for="Fecha_Contratacion" class="form-label">Fecha de contratación</label>
                            @Html.TextBoxFor(m => m.fechaContratacion, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario bruto</label>
                            @Html.TextBoxFor(m => m.salarioBruto, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario neto</label>
                            @Html.TextBoxFor(m => m.salarioBruto, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Días de vacaciones tomados </label>
                            @Html.TextBoxFor(m => m.diasVacacionesTomados, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario neto</label>
                            @Html.TextBoxFor(m => m.deducciones, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario neto</label>
                            @Html.TextBoxFor(m => m.bonos, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario neto</label>
                            @Html.TextBoxFor(m => m.horasExtra, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario neto</label>
                            @Html.TextBoxFor(m => m.montoHorasExtras, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario neto</label>
                            @Html.TextBoxFor(m => m.otrosBeneficios, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario neto</label>
                            @Html.TextBoxFor(m => m.aporteSeguridadSocial, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Salario neto</label>
                            @Html.TextBoxFor(m => m.impuestos, new { @class = "form-control rounded-pill" })
                        </div>

                        <div class="mb-4">
                            <label for="Fecha_Contratacion" class="form-label">Fecha de contratación</label>
                            @Html.TextBoxFor(m => m.periodoInicio, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })
                        </div>

                        <div class="mb-4">
                            <label for="Fecha_Contratacion" class="form-label">Fecha de contratación</label>
                            @Html.TextBoxFor(m => m.periodoFin, "{0:yyyy-MM-dd}", new { @type = "date", @class = "form-control" })
                        </div>

                        <div class="form-group mb-4">
                            <label for="Estado" class="form-label fw-bold">Estado</label>
                            @Html.DropDownListFor(m => m.idEstado, ViewBag.listaEstados as List<SelectListItem>, new { @class = "form-control", id = "estadoDropdown" })
                        </div>

                        <!-- Botón de envío -->
                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fs-5">Enviar Solicitud</button>
                    }

                    <!-- Mensaje de error -->
                    @if (!string.IsNullOrEmpty(ViewBag.MensajePantalla))
                    {
                        <div class="alert alert-warning mt-3">
                            @ViewBag.MensajePantalla
                        </div>
                    }

                    <!-- Alerta de solicitud pendiente -->
                    @if (ViewBag.MostrarAlerta != null && (bool)ViewBag.MostrarAlerta)
                    {
                        <script>
                            Swal.fire({
                                icon: 'warning',
                                title: '¡Solicitud pendiente!',
                                text: 'No puedes realizar una nueva solicitud mientras tienes una en estado pendiente.',
                                confirmButtonText: 'Entendido',
                                customClass: {
                                    confirmButton: 'btn btn-primary'
                                },
                                buttonsStyling: false
                            }).then(() => {
                                window.location.href = '@Url.Action("Index", "Home")';
                            });
                        </script>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
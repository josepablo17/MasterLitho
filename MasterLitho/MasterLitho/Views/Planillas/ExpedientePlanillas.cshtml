@model List<MasterLitho.Models.tPlanilla>

@{
    ViewBag.Title = "ExpedientePlanillas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid main-content">
    <div class="text-center mb-4 bg-primary text-white rounded py-3 shadow-sm">
        <h3 class="mb-0">Expediente de Planillas - @ViewBag.NombreEmpleado</h3>
    </div>

    <a href="@Url.Action("DetalleExpediente", "Expedientes", new { id = ViewBag.IdExpediente })"
       class="btn btn-outline-secondary mb-3">
        <i class="fas fa-arrow-left me-1"></i> Volver al expediente
    </a>


    @if (!Model.Any())
    {
        <div class="alert alert-info">Este empleado no tiene planillas registradas.</div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm p-3 border-start border-4 border-primary">
                    <h6 class="text-muted"><i class="fas fa-file-invoice-dollar me-2 text-primary"></i> Planillas generadas</h6>
                    <h4 class="fw-bold">@Model.Count()</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm p-3 border-start border-4 border-primary">
                    <h6 class="text-muted">Total pagado</h6>
                    <h4 class="fw-bold text-success">₡@Model.Sum(x => x.salarioNeto).ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm p-3 border-start border-4 border-primary">
                    <h6 class="text-muted">Promedio Neto</h6>
                    <h4 class="fw-bold">₡@Model.Average(x => x.salarioNeto).ToString("N2")</h4>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm p-3 border-start border-4 border-primary">
                    <h6 class="text-muted">Última planilla</h6>
                    <h4 class="fw-bold">@Model.OrderByDescending(x => x.fechaPago).First().fechaPago.ToString("MMMM yyyy")</h4>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Periodo</th>
                        <th>Fecha de Pago</th>
                        <th>Bruto</th>
                        <th>Bonos</th>
                        <th>Impuestos</th>
                        <th>CCSS</th>
                        <th>Deducciones</th>
                        <th>Otros</th>
                        <th><strong>Neto</strong></th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.periodoInicio.ToShortDateString() - @item.periodoFin.ToShortDateString()</td>
                            <td>@item.fechaPago.ToShortDateString()</td>
                            <td>₡@item.salarioBruto.ToString("N2")</td>
                            <td>₡@item.bonos.ToString("N2")</td>
                            <td>₡@item.impuestos.ToString("N2")</td>
                            <td>₡@item.aporteSeguridadSocial.ToString("N2")</td>
                            <td>₡@item.deducciones.ToString("N2")</td>
                            <td>₡@item.otrosBeneficios.ToString("N2")</td>
                            <td><strong class="text-success">₡@item.salarioNeto.ToString("N2")</strong></td>
                            <td>
                                <a href="@Url.Action("DetallePlanilla", "Planillas", new { q = item.idPlanilla })" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    }
</div>



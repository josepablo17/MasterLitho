@{
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>MasterLithoADMIN</title>



</head>

<body id="page-top">
    <div id="content-wrapper" class="container">
        <!-- Main Content -->
        <div id="content">
            <!-- Topbar -->
            <h1 class="my-4">Detalles de la Consulta de Planilla</h1>
            <!-- End of Topbar -->
            <!-- Begin Page Content -->
            <div class="container-fluid">
                <!-- Detalles de la Consulta -->
                <div class="card shadow mb-4">
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-primary">
                            Consulta: Inconsistencia en
                            Deducciones
                        </h6>
                    </div>
                    <div class="card-body">
                        <h5 class="font-weight-bold">Empleado:</h5>
                        <p>Empleado</p>

                        <h5 class="font-weight-bold">Descripción de la Consulta:</h5>
                        <p>
                            El empleado reporta una inconsistencia en las deducciones realizadas en su
                            salario durante el mes de agosto de 2024. Se sospecha que hubo un error en el
                            cálculo de las deducciones por concepto de seguro social.
                        </p>

                        <h5 class="font-weight-bold">Detalles Financieros:</h5>
                        <ul>
                            <li><strong>Salario Bruto:</strong> ₡1,200,000</li>
                            <li><strong>Deducciones Incorrectas:</strong> ₡100,000</li>
                            <li><strong>Saldo Neto Reportado:</strong> ₡1,100,000</li>
                        </ul>

                        <h5 class="font-weight-bold">Estado de la Consulta:</h5>
                        <span class="badge badge-warning">Pendiente</span>

                        <h5 class="font-weight-bold">Comentarios del Administrador:</h5>
                        <p>
                            No se ha realizado ningún ajuste aún. Se recomienda revisar el sistema de
                            deducciones para verificar si hay errores en los cálculos.
                        </p>

                        <h5 class="font-weight-bold">Acciones Disponibles:</h5>
                        <button class="btn btn-success btn-sm">Marcar como Resuelta</button>
                        <button class="btn btn-danger btn-sm">Rechazar Consulta</button>
                        <a href="@Url.Action("ConsultarPlanillas","Planillas")" class="btn btn-secondary btn-sm">
                            Volver a
                            Consultas
                        </a>
                    </div>
                </div>
            </div>
            <!-- End Page Content -->
        </div>
        <!-- End Main Content -->
    </div>


    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel"
         aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Ready to Leave?</h5>
                    <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">×</span>
                    </button>
                </div>
                <div class="modal-body">Select "Logout" below if you are ready to end your current session.</div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancel</button>
                    <a class="btn btn-primary" href="login.html">Logout</a>
                </div>
            </div>
        </div>
    </div>

  

</body>

</html>


@model MasterLitho.Models.tPlanilla

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rolUsuario = Session["RolUsuario"] as int?;
}

<div class="container mt-4 mb-5">
    <h2 class="text-center text-dark fw-bold mb-4">
        <i class="fas fa-money-bill-wave text-success me-2"></i> Detalle de Planilla
    </h2>

    <div class="row g-4">
        <!-- Información del Empleado -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <i class="fas fa-user me-2 text-primary"></i> Información del Empleado
                </div>
                <div class="card-body">
                    <p><strong>Nombre:</strong> @Model.nombreEmpleado</p>
                    <p><strong>Fecha de Contratación:</strong> @Model.fechaContratacion.ToShortDateString()</p>
                    <p><strong>Fecha de Pago:</strong> @Model.fechaPago.ToShortDateString()</p>
                    <p><strong>Periodo:</strong> @Model.periodoInicio.ToShortDateString() - @Model.periodoFin.ToShortDateString()</p>
                </div>
            </div>
        </div>

        <!-- Detalles del Pago -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <i class="fas fa-coins me-2 text-success"></i> Detalles del Pago
                </div>
                <div class="card-body">
                    <p><strong>Salario Bruto:</strong> ₡@Model.salarioBruto.ToString("N2")</p>
                    <p><strong>Bonos:</strong> ₡@Model.bonos.ToString("N2")</p>
                    <p><strong>Deducciones:</strong> ₡@Model.deducciones.ToString("N2")</p>
                    <p><strong>Salario Neto:</strong> <span class="fw-bold text-success">₡@Model.salarioNeto.ToString("N2")</span></p>
                </div>
            </div>
        </div>

        <!-- Otros Datos -->
        <div class="col-md-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <i class="fas fa-clipboard-list me-2 text-secondary"></i> Otros Datos
                </div>
                <div class="card-body">
                    <p><strong>Horas Extra:</strong> @Model.horasExtra</p>
                    <p><strong>Días de Vacaciones Tomados:</strong> @Model.diasVacacionesTomados</p>
                    <p><strong>Aporte Seguridad Social:</strong> ₡@Model.aporteSeguridadSocial.ToString("N2")</p>
                    <p><strong>Impuestos:</strong> ₡@Model.impuestos.ToString("N2")</p>
                    <p><strong>Otros Beneficios:</strong> ₡@Model.otrosBeneficios.ToString("N2")</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Botones de acción -->
    <div class="text-center mt-4">
        @if (rolUsuario == 1)
        {
            <a class="btn btn-outline-primary me-2" href="@Url.Action("ConsultarPlanillas", "Planillas")">
                <i class="fas fa-arrow-left me-1"></i> Atrás
            </a>
        }
        else if (rolUsuario == 2)
        {
            <a class="btn btn-outline-primary me-2" href="@Url.Action("ConsultarPlanillasEmpleado", "Planillas")">
                <i class="fas fa-arrow-left me-1"></i> Atrás
            </a>
        }
    </div>
</div>

@model List<MasterLitho.Models.tPlanilla>

@{
    ViewBag.Title = "Consultar Planillas";
}

<h2>Consultar Planillas</h2>

<div class="container mt-4">
    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Nombre del Empleado</th>
                <th>Fecha de Contratación</th>
                <th>Salario Actual</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var empleado in Model)
            {
                <tr>
                    <td>@empleado.nombreEmpleado</td>
                    <td>@empleado.fechaContratacion.ToShortDateString()</td>
                    <td>@empleado.salarioNeto:</td>
                    <td>
                        <a class="btn" href="@Url.Action("CrearPlanilla","Planillas", new { q = empleado.idEmpleado })"><i class="fa fa-pencil-square-o" style="font-size: 1.4em;"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


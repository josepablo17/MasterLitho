@model List<MasterLitho.Models.USUARIO>

@{
    var idUsuario = Session["ID_USUARIO"] != null ? Session["ID_USUARIO"].ToString() : "";
    var nombreUsuario = Session["NOMBRE_USUARIO"] != null ? Session["NOMBRE_USUARIO"].ToString() : "";
}

<!DOCTYPE html>
<html>
<head>
    <title>SignalR Simple Chat</title>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Styles/css/chatStyle.css" rel="stylesheet" />
</head>
<body>

    <div class="container">
        <div class="row clearfix">
            <div class="col-lg-12">
                <div class="card chat-app">
                    <div id="plist" class="people-list">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                            </div>
                            <input type="text" class="form-control" placeholder="Search...">
                        </div>
                        <ul class="list-unstyled chat-list mt-2 mb-0">
                            @foreach (var usuario in Model)
                            {
                                <li class="clearfix user-item" data-id="@usuario.CONNECTION_ID" data-name="@usuario.NOMBRE_USUARIO" data-img="@usuario.IMAGEN_USUARIO">
                                    @if (usuario.IMAGEN_USUARIO == null || string.IsNullOrEmpty(usuario.IMAGEN_USUARIO))
                                    {
                                        <img class="img-profile rounded-circle user-img" src="~/Styles/img/undraw_profile.svg">
                                    }
                                    else
                                    {
                                        <img class="img-profile rounded-circle user-img" src="@Url.Content(usuario.IMAGEN_USUARIO)">
                                    }
                                    <div class="about">
                                        <div class="name">@usuario.NOMBRE_USUARIO</div>
                                        @if (!string.IsNullOrEmpty(usuario.CONNECTION_ID))
                                        {
                                            <div class="status">
                                                <i class="fa fa-circle online"></i> En línea
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="status">
                                                <i class="fa fa-circle offline"></i> Desconectado
                                            </div>
                                        }
                                    </div>
                                </li>

                            }
                        </ul>
                    </div>
                    <div class="chat">
                        <div class="chat-header clearfix">
                            <div class="row">
                                <div class="col-lg-6">
                                    <a href="javascript:void(0);" data-toggle="modal" data-target="#view_info">
                                        <img id="chatUserImage" src="~/Styles/img/undraw_profile.svg" alt="avatar">
                                    </a>
                                    <div class="chat-about">
                                        <h6 class="m-b-0" id="chatWith">Selecciona un usuario</h6>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="chat-history">
                            <ul class="m-b-0" id="discussion">
                               
                            </ul>
                        </div>
                        <div class="chat-message clearfix">
                            <div class="input-group mb-0">
                                <div class="input-group-prepend">
                                    <span  id="sendButton" class="input-group-text"><i class="fa fa-send"></i></span>
                                </div>
                                <input type="text" class="form-control" placeholder="Enter text here..." id="message">
                            </div>
                            @*<button id="sendButton" class="input-group-text" >Enviar</button>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Script references -->
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js" defer></script>
    <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
    <script src="~/signalr/hubs"></script>

    <script>
        $(document).ready(function () {
            var chat = $.connection.chatHub;
            var usuarioActual = "@Html.Raw(nombreUsuario)";
            var usuarioSeleccionado = null;
            var nombreUsuarioSeleccionado = "";

           
            $(".user-item").click(function () {
                usuarioSeleccionado = $(this).data("id");
                nombreUsuarioSeleccionado = $(this).data("name");
                var imagenUsuarioSeleccionado = $(this).data("img") || "/Styles/img/undraw_profile.svg"; 

                
                $("#chatWith").text(nombreUsuarioSeleccionado);
                $("#chatUserImage").attr("src", imagenUsuarioSeleccionado);
            });


            chat.client.receiveMessage = function (user, message) {
                console.log("Mensaje recibido de " + user + ": " + message);
                let alignClass = (user === usuarioActual) ? "text-right" : "";
                let messageClass = (user === usuarioActual) ? "my-message" : "other-message";

                            var messageHtml = `<li class="clearfix">
                 <div class="message-data ${alignClass}">
                     <span class="message-data-time">${new Date().toLocaleTimeString()}</span>
                     <strong>${user}</strong>
                 </div>
                 <div class="message ${messageClass}">${message}</div>
                    </li>`;

                $("#discussion").append(messageHtml);
            };



            
            $("#sendButton").click(function () {
                var message = $("#message").val().trim();
                if (!usuarioSeleccionado) {
                    alert("Por favor, selecciona un usuario para chatear.");
                    return;
                }
                if (message === "") {
                    alert("El mensaje no puede estar vacío.");
                    return;
                }

                let messageHtml = `<li class="clearfix">
                    <div class="message-data text-right">
                        <span class="message-data-time">${new Date().toLocaleTimeString()}</span>
                        <strong>${usuarioActual}</strong>
                    </div>
                    <div class="message other-message float-right">${message}</div>
                </li>`;

                $("#discussion").append(messageHtml);
                chat.server.sendToUser(usuarioActual, usuarioSeleccionado, message);
                $("#message").val("");  
            });
        });
    </script>
</body>
</html>

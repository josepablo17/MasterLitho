﻿@model List<MasterLitho.Models.USUARIO>

@{

    var idUsuario = Session["ID_USUARIO"] != null ? Session["ID_USUARIO"].ToString() : "";
    var nombreUsuario = Session["NOMBRE_USUARIO"] != null ? Session["NOMBRE_USUARIO"].ToString() : "";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>MasterLithoADMIN</title>

    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Styles/css/chatStyle.css" rel="stylesheet" />

    </head>
<body id="page-top">
    <div id="content-wrapper" class="container">
        <div id="content">
            <div class="row clearfix">
                <div class="col-lg-12">
                    <div class="card chat-app">
                        <div id="plist" class="people-list">
                            <div class="input-group">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-search"></i></span>
                                </div>
                                <input type="text" class="form-control" id="myInput" onkeyup="searchByName()" placeholder="Search...">
                            </div>
                            <ul class="list-unstyled chat-list mt-2 mb-0" id="myUl">
                                @foreach (var usuario in Model)
                                {
                                    <li class="clearfix user-item"
                                        data-id="@usuario.ID_USUARIO"
                                        data-connection-id="@usuario.CONNECTION_ID"
                                        data-name="@usuario.NOMBRE_USUARIO"
                                        data-img="@usuario.IMAGEN_USUARIO">

                                        @if (usuario.IMAGEN_USUARIO == null || string.IsNullOrEmpty(usuario.IMAGEN_USUARIO))
                                        {
                                            <img class="img-profile rounded-circle user-img" src="~/Styles/img/undraw_profile.svg">
                                        }
                                        else
                                        {
                                            <img class="img-profile rounded-circle user-img" src="@Url.Content(usuario.IMAGEN_USUARIO)">
                                        }
                                        <div class="about">
                                            <div class="name">@usuario.NOMBRE_USUARIO</div>
                                            @if (!string.IsNullOrEmpty(usuario.CONNECTION_ID))
                                            {
                                                <div class="status">
                                                    <i class="fa fa-circle online"></i> En línea
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="status">
                                                    <i class="fa fa-circle offline"></i> Desconectado
                                                </div>
                                            }
                                        </div>
                                    </li>


                                }
                            </ul>
                        </div>
                        <div class="chat">
                            <div class="chat-header clearfix">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <a href="javascript:void(0);" data-toggle="modal" data-target="#view_info">
                                            <img id="chatUserImage" src="~/Styles/img/undraw_profile.svg" alt="avatar">
                                        </a>
                                        <div class="chat-about">
                                            <h6 class="m-b-0" id="chatWith">Selecciona un usuario</h6>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 hidden-sm text-right">
                                        <a href="javascript:void(0);" id="EliminarChat" class="btn btn-outline-danger"><i class="fa fa-trash"></i></a>
                                        <a href="javascript:void(0);" id="infoChat" class="btn btn-outline-primary" data-toggle="tooltip" data-placement="top" title="El chat sera borrado semanalmente">
                                            <i class="fa fa-info-circle"></i>
                                        </a>
                                    </div>

                                </div>
                            </div>

                            <div class="chat-history">
                                <ul class="m-b-0" id="discussion">
                                </ul>
                            </div>
                            <div class="chat-message clearfix">
                                <div class="input-group mb-0">
                                    <div class="input-group-prepend">
                                        <span id="sendButton" class="input-group-text"><i class="fa fa-send"></i></span>
                                    </div>
                                    <input type="text" class="form-control" placeholder="Enter text here..." id="message">
                                </div>
                                @*<button id="sendButton" class="input-group-text" >Enviar</button>*@
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </div>
    


            <!-- Script references -->
            <script src="~/Scripts/jquery-3.7.1.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js" defer></script>
            <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
            <script src="~/signalr/hubs"></script>

            <script>
    $(document).ready(function () {
             $('[data-toggle="tooltip"]').tooltip();
            var chat = $.connection.chatHub;
            var usuarioActual = "@Html.Raw(nombreUsuario)";
            var idUsuarioActual = "@Html.Raw(idUsuario)";
            var usuarioSeleccionado = null;
            var idUsuarioSeleccionado = null;
            var nombreUsuarioSeleccionado = "";
            var btnSendActive = false;



            var roomName = ""

            $(".user-item").click(function () {

                idUsuarioSeleccionado = $(this).data("id");
                usuarioSeleccionado = $(this).data("connection-id");
                nombreUsuarioSeleccionado = $(this).data("name");
                var imagenUsuarioSeleccionado = $(this).data("img") || "/Styles/img/undraw_profile.svg";

                roomName = [idUsuarioActual, idUsuarioSeleccionado].sort().join("_");

                $("#chatWith").text(nombreUsuarioSeleccionado);
                $("#chatUserImage").attr("src", imagenUsuarioSeleccionado);

                $.ajax({
                    url: "/Chat/ObtenerMensajes",
                    type: "GET",
                    data: { roomName: roomName },
                    success: function (data) {
                        $("#discussion").empty();
                        if (data.length === 0) {
                            $("#discussion").append(`<li class="text-center text-muted">No hay mensajes. ¡Envía el primero!</li>`);
                        } else {
                            data.forEach(function (message) {
                                chat.client.receiveMessage(message.Emisor, message.Mensaje, message.Hora, false);
                            });
                        }
                    }
                });



                chat.server.joinRoom(roomName);
            });

            $("#EliminarChat").click(function () {
                if (!roomName) {
                    Swal.fire("Selecciona un usuario primero para eliminar el chat.");
                    return;
                }
                Swal.fire({
                    title: "Estas seguro?",
                    text: "No se podra recuerar esa informacion!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#3085d6",
                    cancelButtonColor: "#d33",
                    cancelButtonText: "Cancelar",
                    confirmButtonText: "Si, eliminar!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: "/Chat/EliminarMensajes",
                            type: "POST",
                            data: { roomName: roomName },
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire({
                                        title: "Eliminado!",
                                        text: response.message,
                                        icon: "success"
                                    });
                                    $("#discussion").empty();

                                } else {
                                    Swal.fire({
                                        icon: "error",
                                        title: "Oops...",
                                        text: response.message,

                                    });
                                }
                            },
                            error: function (xhr, status, error) {
                                alert("Error al eliminar el chat: " + error);
                            }
                        });

                    }
                });



            });



            chat.client.receiveMessage = function (user, message, time, isRealTime, idReceptor) {
                console.log("Mensaje recibido de " + user + ": " + message);

                if (isRealTime === true && idUsuarioActual != idReceptor) {
                    return;
                }

                let alignClass = (user === usuarioActual) ? "text-right" : "";
                let messageClass = (user === usuarioActual) ? "my-message float-right" : "other-message";

                var messageHtml = `<li class="clearfix">
                    <div class="message-data ${alignClass}">
                        <span class="message-data-time">${time}</span>
                        <strong>${user}</strong>
                    </div>
                    <div class="message ${messageClass}">${message}</div>
                </li>`;

                $("#discussion").append(messageHtml);
            };









            $("#sendButton").click(function () {
                var message = $("#message").val().trim();
                if (usuarioSeleccionado == null) {
                    alert("Por favor, selecciona un usuario para chatear.");
                    return;
                }
                if (message === "") {
                    alert("El mensaje no puede estar vacío.");
                    return;
                }

                let messageHtml = `<li class="clearfix">
                    <div class="message-data text-right">
                        <span class="message-data-time">${new Date().toLocaleTimeString("es-ES", { hour: "2-digit", minute: "2-digit", hour12: true }).replace("a. m.", "a. m.").replace("p. m.", "p. m.")}</span>
                        <strong>${usuarioActual}</strong>
                    </div>
                    <div class="message my-message float-right">${message}</div>
                </li>`;

                $("#discussion").append(messageHtml);

                chat.server.sendMessageToRoom(roomName, usuarioActual, message, idUsuarioSeleccionado);
                $("#message").val("");
            });




        });


    function infoChat() {
        alert("Información del chat");
    }
    function searchByName() {
        var input, filter, ul, li, div, i, txtValue, visibleCount = 0;
        input = document.getElementById("myInput");
        filter = input.value.toUpperCase();
        ul = document.getElementById("myUl");
        li = ul.getElementsByTagName("li");

        var noResults = document.getElementById("noResults");
        if (noResults) {
            noResults.remove();
        }

        for (i = 0; i < li.length; i++) {
            div = li[i].getElementsByClassName("name")[0];
            if (div) {
                txtValue = div.textContent || div.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    li[i].style.display = "";
                    visibleCount++;
                } else {
                    li[i].style.display = "none";
                }
            }
        }


        if (visibleCount === 0) {
            var noResultsLi = document.createElement("li");
            noResultsLi.id = "noResults";
            noResultsLi.className = "text-center text-muted";
            noResultsLi.textContent = "No se encontraron usuario.";
            ul.appendChild(noResultsLi);
        }
    }


            </script>
</body>
</html>

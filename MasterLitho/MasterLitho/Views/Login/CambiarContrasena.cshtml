@model MasterLitho.Models.tUsuario

@{
    ViewBag.Title = "Recuperar Acceso";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="page-wrapper d-flex align-items-start justify-content-center min-vh-100" style="background-color: #f9f9f9; padding-top: 5vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <a href="@Url.Action("Index", "Home")">
                                <img src="~/Styles/img/martelithocr-logo (1).png" alt="Logo" class="img-fluid" style="width: 120px;">
                            </a>
                        </div>

                        @if (ViewBag.MensajePantalla != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                @ViewBag.MensajePantalla
                            </div>
                        }

                        @using (Html.BeginForm("CambiarContrasena", "Login"))
                        {
                            <h3 class="text-center fw-bold mb-4 text-primary">Cambiar Contraseña</h3>

                            <div class="form-floating mb-3 position-relative">
                                @Html.TextBoxFor(m => m.contrasenaAnterior, new { @class = "form-control", @type = "password", @placeholder = "Contraseña Actual", @id = "PassWord1", @oninput = "toggleIconVisibility('PassWord1')" })
                                <label for="PassWord1">Contraseña Actual</label>
                                <span id="icon-PassWord1" class="position-absolute end-0 top-50 translate-middle-y me-3 cursor-pointer"
                                      onclick="toggleVisibility('PassWord1')"
                                      style="z-index: 10; display: none; align-items: center; justify-content: center;">
                                    <i class="bi bi-eye text-muted"></i>
                                </span>
                            </div>

                            <div class="form-floating mb-3 position-relative">
                                @Html.TextBoxFor(m => m.contrasena, new { @class = "form-control", @type = "password", @placeholder = "Nueva Contraseña", @id = "PassWord2", @oninput = "toggleIconVisibility('PassWord2')" })
                                <label for="PassWord2">Nueva Contraseña</label>
                                <span id="icon-PassWord2" class="position-absolute end-0 top-50 translate-middle-y me-3 cursor-pointer"
                                      onclick="toggleVisibility('PassWord2')"
                                      style="z-index: 10; display: none; align-items: center; justify-content: center;">
                                    <i class="bi bi-eye text-muted"></i>
                                </span>
                            </div>

                            <div class="form-floating mb-3 position-relative">
                                @Html.TextBoxFor(m => m.confirmarContrasena, new { @class = "form-control", @type = "password", @placeholder = "Confirmar Contraseña", @id = "PassWord3", @oninput = "toggleIconVisibility('PassWord3')" })
                                <label for="PassWord3">Confirmar Contraseña</label>
                                <span id="icon-PassWord3" class="position-absolute end-0 top-50 translate-middle-y me-3 cursor-pointer"
                                      onclick="toggleVisibility('PassWord3')"
                                      style="z-index: 10; display: none; align-items: center; justify-content: center;">
                                    <i class="bi bi-eye text-muted"></i>
                                </span>
                            </div>

                            <div class="d-grid mb-3">
                                <input type="submit" onclick="mostrarNotificacionExito(event, this)" class="btn btn-primary py-2 rounded-pill" value="Realizar Cambio" style="background-color: #007bff; border-color: #007bff;" />
                            </div>

                            <div class="d-grid">
                                <a class="btn btn-outline-secondary py-2 rounded-pill" href="@Url.Action("Index", "Home")">Volver</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="~/Styles/FuncionesJS/CambiarContrasena.js"></script>

@model MasterLitho.Models.tUsuario

@{
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">

    <title>Iniciar sesión - MasterLitho</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">

  
   
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i"
          rel="stylesheet">

    
    

    <style>
       
        html, body {
            overflow: hidden;
            height: 100%;
        }
    </style>
</head>

<body class="bg-gradient-primary">

    <div class="d-flex align-items-center justify-content-center bg-light" style="height: 70vh;">

        <div class="row justify-content-center w-100">
            <div class="col-xl-5 col-lg-6 col-md-8">
                <div class="card shadow-lg border-0 rounded-lg">



                    <div class="card-body p-5">
                        <div class="text-center">
                            <h1 class="h4 text-gray-900 mb-4">¡Bienvenido de nuevo!</h1>
                        </div>
                        @if (ViewBag.MensajePantalla != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                @ViewBag.MensajePantalla
                            </div>
                        }

                        @if (ViewBag.MensajePantalla != null)
                        {
                            <script>
                                console.warn("Login fallido:", "@ViewBag.MensajePantalla");
                            </script>
                        }


                        @using (Html.BeginForm("IniciarSesion", "Login"))
                        {
                            <h3 class="text-center fw-bold mb-4">Iniciar Sesión</h3>

                            <div class="mb-3">
                                <label for="Nombre_Usuario" class="form-label">Correo</label>
                                @Html.TextBoxFor(m => m.correoUsuario, new { @class = "form-control rounded-pill", @placeholder = "Correo electronico" })
                            </div>

                            <div class="mb-4 position-relative">
                                <label for="PassWord" class="form-label">Contraseña</label>
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.contrasena, new { @class = "form-control rounded-pill pe-5", @type = "password", @id = "PassWord", @placeholder = "Contraseña" })
                                    <span onclick="toggleVisibility('PassWord')">
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <a href="@Url.Action("RecuperarAcceso", "Login")">¿Olvidaste tu contraseña?</a>
                            </div>

                            <input type="submit" class="btn btn-dark btn-block w-100 rounded-pill py-2 fs-5 mb-3" value="Iniciar Sesión" />
                        }
                        <hr>
                        <div class="text-center">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/Styles/FuncionesJS/CambiarContrasena.js"></script>

</body>

</html>
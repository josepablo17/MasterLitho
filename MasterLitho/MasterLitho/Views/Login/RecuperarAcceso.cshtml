@model MasterLitho.Models.tUsuario

@{
    ViewBag.Title = "Recuperar Acceso";
    Layout = "~/Views/Shared/_LayoutExterno.cshtml";
}

<div class="d-flex align-items-center justify-content-center bg-light" style="height: 70vh;">
    <div class="col-md-8 col-lg-6 col-xxl-4">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">

                <!-- Mensaje de error -->
                @if (ViewBag.MensajePantalla != null)
                {
                    <div class="alert alert-danger text-center" role="alert">
                        @ViewBag.MensajePantalla
                    </div>
                }

                <!-- Formulario -->
                @using (Html.BeginForm("RecuperarAcceso", "Login"))
                {
                    <h3 class="text-center fw-bold mb-4" style="color: #333;">Recuperar Acceso</h3>

                    <!-- Campo de correo -->
                    <div class="mb-4">
                        <label for="Correo_Usuario" class="form-label" style="color: #333;">Correo Electrónico</label>
                        @Html.TextBoxFor(m => m.correoUsuario,
                            new
                                 {
                                @class = "form-control rounded-pill",
                                @type = "email",
                                @placeholder = "Ingrese su correo",
                                @style = "border: 2px solid #ced4da; color: #495057;"
                            })
                    </div>

                    <!-- Botón de recuperar -->
                    <input type="submit"
                           class="btn w-100 rounded-pill py-2 fs-5 mb-4"
                           style="background-color: #343a40; color: white; border: none;"
                           value="Recuperar" />

                    <!-- Enlace para iniciar sesión -->
                    <div class="text-center">
                        <p class="mb-0" style="color: #333;">¿Ya tienes una cuenta?</p>
                        <a href="@Url.Action("IniciarSesion", "Login")" style="color: #007bff;">Iniciar Sesión</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

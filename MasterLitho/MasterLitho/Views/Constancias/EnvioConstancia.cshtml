@model MasterLitho.Models.tConstancia

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="content-wrapper" class="container">
    <!-- Main Content -->
    <div id="content">

        @if (TempData["MensajePantalla"] != null)
        {
            <div id="alertaMensaje" class="alert alert-danger text-center fade show mt-3" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["MensajePantalla"]
            </div>
        }

        @if (TempData["MensajePantallaExito"] != null)
        {
            <div id="alertaMensaje" class="succ alert-success text-center fade show mt-3" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["MensajePantallaExito"]
            </div>
        }


        @if (Session["rolUsuario"] != null && Session["rolUsuario"].ToString() == "2")
        {
            <ul class="nav nav-tabs" id="constanciaTabs">
                <li class="nav-item">
                    <a class="nav-link active" data-bs-toggle="tab" href="#nueva">Emitir Nueva Constancia</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="tab" href="#enviadas">Constancias Enviadas</a>
                </li>
            </ul>

            <div class="tab-content mt-3">
                <div class="tab-pane fade show active" id="nueva">
                    <div class="card shadow-lg mb-4">
                        <div class="card-header bg-primary text-white py-3">
                            <h5 class="m-0 font-weight-bold">Emitir Nueva Constancia</h5>
                        </div>
                        <div class="card-body">
                            @using (Html.BeginForm("GenerarConstanciaEmpleado", "Constancias", FormMethod.Post))
                            {
                                <div class="mb-3">
                                    <label for="tipoConstancia" class="form-label fw-semibold">
                                        <i class="fas fa-envelope me-2"></i> Tipo de Constancia
                                    </label>
                                    @Html.DropDownListFor(m => m.ID_TIPO_CONSTANCIA, ViewBag.tiposConstancias as List<SelectListItem>, new { @class = "form-select" })
                                </div>

                                <button type="submit" class="btn btn-success w-100 py-2" id="btnVistaPrevia">
                                    Generar Constancia
                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="enviadas">
                    <h1 class="my-4 text-center">Historial de Constancias Solicitadas</h1>

                    <div class="card shadow mb-4">
                        <div class="card-header py-3">
                            <h6 class="m-0 font-weight-bold text-primary">Historial de Constancias Enviadas</h6>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered table-striped" id="dataTable" width="100%" cellspacing="0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>ID</th>
                                            <th>Nombre empleado</th>
                                            <th>Tipo de Constancia</th>
                                            <th>Fecha de emisión</th>
                                            <th>Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.Constancias)
                                        {
                                            <tr>
                                                <td>@item.ID_CONSTANCIA</td>
                                                <td>@item.NOMBRE_EMPLEADO</td>
                                                <td>@item.NOMBRE_TIPO_CONSTANCIA</td>
                                                <td>@item.FECHA_EMISION.ToString("yyyy/MM/dd")</td>
                                                <td>
                                                    <a href="@Url.Action("PrintConstancia", "Constancias", new { q = item.ID_CONSTANCIA })" class="btn btn-primary btn-sm" title="Ver Constancia">
                                                        <i class="bi bi-file-earmark-pdf"></i>
                                                    </a>

                                                    
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Session["rolUsuario"] != null && Session["rolUsuario"].ToString() == "1")
        {
            <h1 class="my-4 text-center">Historial de Constancias Solicitadas</h1>

            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Historial de Constancias Enviadas</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" id="dataTable1" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre empleado</th>
                                    <th>Tipo de Constancia</th>
                                    <th>Fecha de emisión</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Constancias)
                                {
                                    <tr>
                                        <td>@item.ID_CONSTANCIA</td>
                                        <td>@item.NOMBRE_EMPLEADO</td>
                                        <td>@item.NOMBRE_TIPO_CONSTANCIA</td>
                                        <td>@item.FECHA_EMISION.ToString("yyyy/MM/dd")</td>
                                        <td>
                                            <a href="@Url.Action("PrintConstancia", "Constancias", new { q = item.ID_CONSTANCIA })" class="btn btn-primary btn-sm" title="Ver Constancia">
                                                <i class="bi bi-file-earmark-pdf"></i>
                                            </a>

                                            
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


<script>
    $(document).ready(function () {
        setTimeout(function () {
            $("#alertaMensaje").fadeOut("slow");
        }, 5000);

        $('#dataTable').DataTable({
            "language": {
                "url": "https://cdn.datatables.net/plug-ins/1.12.1/i18n/Spanish.json"
            }
        });

        $('#dataTable1').DataTable({
            "language": {
                "url": "https://cdn.datatables.net/plug-ins/1.12.1/i18n/Spanish.json"
            }
        });
    });
</script>

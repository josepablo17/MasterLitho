@model List<MasterLitho.Models.tConstancia>
@{

    Layout = "~/Views/Shared/_LayoutExterno.cshtml";

}
<link href="~/Styles/css/ConstanciaPDF.css" rel="stylesheet" />

<div class="invoice-container">
    <div class="invoice-header">
        
        <p>Fecha de emisión: @DateTime.Now.ToString("yyyy/MM/dd")</p>
    </div>

    <div class="invoice-section">
        <p class="section-title">A quien corresponda:</p>
        <p>
            Por medio de la presente, certificamos que el/la empleado/a <strong>@Model.FirstOrDefault().NOMBRE_EMPLEADO @Model.FirstOrDefault().APELLIDOS_EMPLEADO</strong>,
            identificado/a con cédula N° <strong>@Model.FirstOrDefault().IDENTIFICACION</strong>, labora en nuestra empresa
            <strong>MasterLitho S.A.</strong> desde el <strong>@Model.FirstOrDefault().FECHA_INGRESO.ToString("yyyy/MM/dd")</strong>.
        </p>
        <p>
            El/la Sr(a). @Model.FirstOrDefault().NOMBRE_EMPLEADO percibe un salario mensual bruto de
            <strong>¢@Model.FirstOrDefault().SALARIO</strong>, correspondiente al desempeño que realiza en el departamento de
            <strong>@Model.FirstOrDefault().NOMBRE_DEPARTAMENTO</strong>.
        </p>
        <p>
            Esta constancia se emite a solicitud del interesado para fines salariales que estime convenientes, y puede ser
            presentada ante cualquier autoridad o entidad que lo requiera. Los datos proporcionados son verídicos
            y respaldados por nuestra empresa.
        </p>
    </div>


    <hr>

    <div class="firma">
        <p>Atentamente,</p>
        <div class="signature-line"></div>
        <p><strong>Sebastian Coto Gonzalez</strong></p>
        <p>Gerente TI</p>
    </div>

    <div class="footer">
        <p>MasterLitho S.A. | Todos los derechos reservados</p>
    </div>
</div>

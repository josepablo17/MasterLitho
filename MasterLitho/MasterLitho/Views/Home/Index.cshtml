@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var noticias = ViewBag.Noticias as List<MasterLitho.Models.NOTICIAS> ?? new List<MasterLitho.Models.NOTICIAS>();
}



<h1 class="text-center my-4 text-primary fw-bold">Bienvenido a MasterLitho</h1>



<div class="container">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var noticia in noticias)
        {
            <div class="col">
                <div class="card shadow-sm h-100 border-0 rounded-4 overflow-hidden cursor-pointer" data-toggle="modal" data-target="#noticiaModal-@noticia.ID_NOTICIA">
                    @if (!string.IsNullOrEmpty(noticia.IMAGEN_RUTA))
                    {
                        <img src="@Url.Content(noticia.IMAGEN_RUTA)" class="card-img-top" alt="Imagen de @noticia.TITULO" style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">@noticia.TITULO</h5>
                        <p class="card-text text-muted text-truncate" style="max-height: 3em; overflow: hidden;">@noticia.DESCRIPCION</p>
                        <p class="card-text"><small class="text-muted">Publicado el: @noticia.FECHA_PUBLICACION.ToString("dd/MM/yyyy")</small></p>
                    </div>
                </div>
            </div>


            <!-- Modal de Noticia -->
            <div class="modal fade" id="noticiaModal-@noticia.ID_NOTICIA" tabindex="-1" role="dialog" aria-labelledby="modelTitleId-@noticia.ID_NOTICIA" aria-hidden="true">
                <div class="modal-dialog modal-lg modal-dialog-centered position-fixed top-0 start-50 translate-middle-x" role="document">
                    <div class="modal-content rounded-4">
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title fw-bold">@noticia.TITULO</h5>
                            <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body text-center">
                            @if (!string.IsNullOrEmpty(noticia.IMAGEN_RUTA))
                            {
                                <img src="@Url.Content(noticia.IMAGEN_RUTA)" class="img-fluid mb-3 rounded-3 shadow-sm" alt="Imagen de @noticia.TITULO">
                            }
                            <p class="fs-5">@noticia.DESCRIPCION</p>
                            <p><small class="text-muted">Publicado el: @noticia.FECHA_PUBLICACION.ToString("dd/MM/yyyy")</small></p>
                        </div>
                        <div class="modal-footer d-flex justify-content-center">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>








        }


    </div>
</div>


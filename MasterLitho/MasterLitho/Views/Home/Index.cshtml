@{
    var noticias = ViewBag.Noticias as List<MasterLitho.Models.NOTICIAS> ?? new List<MasterLitho.Models.NOTICIAS>();
}

<h1 class="text-center my-4 text-primary fw-bold">Bienvenido a MasterLitho</h1>

<div class="container">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var noticia in noticias)
        {
            <div class="col">
                <div class="card shadow-sm h-100 border-0 rounded-4 overflow-hidden cursor-pointer" data-bs-toggle="modal" data-bs-target="#noticiaModal-@noticia.ID_NOTICIA">
                    @if (!string.IsNullOrEmpty(noticia.IMAGEN_RUTA))
                    {
                        <img src="@Url.Content(noticia.IMAGEN_RUTA)" class="card-img-top" alt="Imagen de @noticia.TITULO" style="height: 200px; object-fit: cover;">
                    }
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark">@noticia.TITULO</h5>
                        <p class="card-text text-muted text-truncate" style="max-height: 3em; overflow: hidden;">@noticia.DESCRIPCION</p>
                        <p class="card-text"><small class="text-muted">Publicado el: @noticia.FECHA_PUBLICACION.ToString("dd/MM/yyyy")</small></p>
                    </div>
                </div>
            </div>


           
            <style>
                .modal.full-fix .modal-dialog {
                    position: fixed;
                    top: 50% !important;
                    left: 50% !important;
                    transform: translate(-50%, -50%) !important;
                    margin: 0 !important;
                    width: 90vw;
                    max-width: 800px;
                    z-index: 1055;
                }
            </style>

            <div class="modal fade full-fix" id="noticiaModal-@noticia.ID_NOTICIA" tabindex="-1" aria-labelledby="modelTitleId-@noticia.ID_NOTICIA" aria-hidden="true">
                <div class="modal-dialog" role="document">
                    <div class="modal-content shadow">
              
                        <div class="modal-header bg-primary text-white">
                            <h5 class="modal-title fw-bold">@noticia.TITULO</h5>
                        </div>

                     
                        <div class="modal-body text-center px-4 px-md-5">
                            <div class="mx-auto" style="max-width: 700px;">
                                @if (!string.IsNullOrEmpty(noticia.IMAGEN_RUTA))
                                {
                                    <img src="@Url.Content(noticia.IMAGEN_RUTA)"
                                         class="img-fluid mb-3 rounded-3 shadow-sm mx-auto d-block"
                                         style="max-width: 100%; max-height: 400px;"
                                         alt="Imagen de @noticia.TITULO" />
                                }

                                <p class="fs-5">@noticia.DESCRIPCION</p>
                                <p>
                                    <small class="text-muted">
                                        Publicado el: @noticia.FECHA_PUBLICACION.ToString("dd/MM/yyyy")
                                    </small>
                                </p>
                            </div>
                        </div>

                        <div class="modal-footer d-flex justify-content-center">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>

        }

    </div>
</div>

<script>
        $(document).ready(function () {
            var mensaje = "@TempData["Exito"]".replace(/&quot;/g, '"');
            if (mensaje && mensaje !== '') {
                alertaExito(mensaje);
            }
        });
</script>





@{
    var idUser = Session["ID_USUARIO"] != null ? Session["ID_USUARIO"].ToString() : "";
    var nombreUsuario = Session["NOMBRE_USUARIO"] != null ? Session["NOMBRE_USUARIO"].ToString() : "";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <title>MasterLitho</title>
    <style>
        .sidebar {
            transition: background-color 0.3s ease;
        }

        .sidebar-admin {
            background-color: #061b9c;
        }

        .sidebar-employee {
            background-color: #007bff;
        }

        .sidebar .nav-link {
            color: #ffffff;
        }

            .sidebar .nav-link:hover {
                color: #f8f9fa;
            }

        .sidebar .sidebar-brand-text {
            color: #ffffff;
        }
    </style>
    <link href="~/Styles/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <!-- Custom styles for this template -->
    <link href="~/Styles/css/sb-admin-2.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.5/css/jquery.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.0/css/buttons.dataTables.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link href="~/Styles/css/sb-admin-2.min.css" rel="stylesheet">
    <link href="~/Styles/css/EstilosDataTables.css" rel="stylesheet">

</head>
<body id="page-top">

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <ul class="navbar-nav sidebar @((Session["rolUsuario"] != null && Session["rolUsuario"].ToString() == "1") ? "sidebar-admin" : "sidebar-employee") accordion" id="accordionSidebar">

            @if (Session["rolUsuario"] != null && Session["rolUsuario"].ToString() == "1")
            {
                <li class="nav-item">
                    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="@Url.Action("Index","Home")">
                        <div class="sidebar-brand-icon rotate-n-15">
                            <i class=""></i>
                        </div>
                        <div class="sidebar-brand-text mx-3">MasterLithoADMIN</div>
                    </a>
                </li>

                <li><hr class="sidebar-divider my-0"></li>
                <li><hr class="sidebar-divider"></li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("GestionarVacaciones", "SolicitudVacaciones")">
                        <i class="fas fa-fw fa-calendar-check"></i>
                        <span>Solicitudes de Vacaciones</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EnvioConstancia", "Constancias")">
                        <i class="fas fa-fw fa-paper-plane"></i>
                        <span>Envio de Constancias</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("GestionQuejasReportes", "QuejasReportes")">
                        <i class="fas fa-fw fa-exclamation-circle"></i>
                        <span>Reportes y Quejas</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ConsultarPlanillas", "Planillas")">
                        <i class="fas fa-fw fa-table"></i>
                        <span>Consultas de Planillas</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("IndexExpedientes", "Expedientes")">
                        <i class="fas fa-fw fa-folder"></i>
                        <span>Gestión de Expedientes</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ConsultarFormularios", "Formularios")">
                        <i class="fas fa-fw fa-clipboard"></i>
                        <span>Formularios</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Noticias", "Noticias")">
                        <i class="fas fa-fw fa-newspaper"></i>
                        <span>Gestión de Noticias</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Calendario", "Calendario")">
                        <i class="fas fa-fw fa-calendar-alt"></i>
                        <span>Calendario</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("GestionUsuarios", "Usuarios")">
                        <i class="fas fa-fw fa-user"></i>
                        <span>Gestion Usuarios</span>
                    </a>
                </li>


            }

            @if (Session["rolUsuario"] != null && Session["rolUsuario"].ToString() == "2")
            {
                <li class="nav-item">
                    <a class="sidebar-brand d-flex align-items-center justify-content-center" href="@Url.Action("Index","Home")">
                        <div class="sidebar-brand-icon rotate-n-15">
                            <i class=""></i>
                        </div>
                        <div class="sidebar-brand-text mx-3">MasterLitho</div>
                    </a>
                </li>

                <li><hr class="sidebar-divider my-0"></li>
                <li><hr class="sidebar-divider"></li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("SolicitarVacaciones","SolicitudVacaciones")">
                        <i class="fas fa-fw fa-calendar-check"></i>
                        <span>Solicitar Vacaciones</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EnvioConstancia","Constancias")">
                        <i class="fas fa-fw fa-paper-plane"></i>
                        <span>Solicitar Constancia</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("EnviarQueja","QuejasReportes")">
                        <i class="fas fa-fw fa-exclamation-circle"></i>
                        <span>Reportes y Quejas</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Expedientes","EmpleadoExpedientes")">
                        <i class="fas fa-fw fa-table"></i>
                        <span>Consulta de Expediente</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ConsultarPlanillasEmpleado","Planillas")">
                        <i class="fas fa-fw fa-folder"></i>
                        <span>Consultar planilla</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("ConsultarDiasVacaciones","SolicitudVacaciones")">
                        <i class="fas fa-fw fa-clipboard"></i>
                        <span>Dias de vacaciones</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("FormulariosAsignados","Formularios")">
                        <i class="fas fa-fw fa-newspaper"></i>
                        <span>Consultar Formularios</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="@Url.Action("Calendario", "Calendario")">
                        <i class="fas fa-fw fa-calendar-alt"></i>
                        <span>Calendario</span>
                    </a>
                </li>
            }

            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Chat", "Chat")">
                    <i class="fas fa-fw fa-envelope"></i>
                    <span>Chat</span>
                </a>
            </li>

            <li class="text-center d-none d-md-inline">
                <button class="rounded-circle border-0" id="sidebarToggle"></button>
            </li>

        </ul>


        <!-- End of Sidebar -->
        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">
                <header>
                    <!-- Topbar -->
                    <nav class=" navbar navbar-expand navbar-light bg-white topbar mb-4 static-top shadow">

                        <!-- Sidebar Toggle (Topbar) -->
                        <button id="sidebarToggleTop" class="btn btn-link d-md-none rounded-circle mr-3">
                            <i class="fa fa-bars"></i>
                        </button>

                        <!-- Topbar Navbar -->
                        <ul class="navbar-nav ml-auto">
                            <!-- Nav Item - User Information -->
                            <li class="nav-item dropdown no-arrow">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button"
                                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <span class="mr-2 d-none d-lg-inline text-gray-600 small">@Session["NOMBRE_USUARIO"]</span>

                                    @if (Session["IMAGEN_USUARIO"] != null)
                                    {
                                        <img class="img-profile rounded-circle" src="@Session["IMAGEN_USUARIO"]" alt="Imagen de usuario">
                                    }
                                    else
                                    {
                                        <img class="img-profile rounded-circle" src="~/Styles/img/undraw_profile.svg" alt="Imagen por defecto">
                                    }
                                </a>

                                <!-- Dropdown - User Information -->
                                <div class="dropdown-menu dropdown-menu-right shadow animated--grow-in"
                                     aria-labelledby="userDropdown">
                                    <a class="dropdown-item" href="@Url.Action("modificarPerfil","Usuarios")">
                                        <i class="fas fa-user-circle fa-sm fa-fw mr-2 text-red-400"></i>
                                        Perfil
                                    </a>
                                    <a class="dropdown-item" href="@Url.Action("ConsultarMisSolicitudes","SolicitudVacaciones")">
                                        <i class="fas fa-calendar-day fa-sm fa-fw mr-2 text-red-400"></i>
                                        Mis solicitudes de vacaciones
                                    </a>
                                    <a class="dropdown-item" href="@Url.Action("MisQuejasYReportes","QuejasReportes")">
                                        <i class="fas  fa-list fa-sm fa-fw mr-2 text-red-400"></i>
                                        Mis reportes y quejas
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item" id="logoutButton" href="#" onclick="confirmarCerrarSesion(event)">
                                        <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2 text-red-400"></i>
                                        Cerrar Sesión
                                    </a>
                                </div>

                            </li>

                        </ul>

                    </nav>

                </header>


                <div class="container-fluid">
                    <div class="row">
                        @RenderBody()
                    </div>
                </div>



                <footer class="sticky-footer bg-white">
                    <div class="container my-auto">
                        <div class="copyright text-center my-auto">
                            <span>Copyright &copy; MasterLitho 2025</span>
                        </div>
                    </div>
                </footer>

            </div>
            <!-- End of Content Wrapper -->

        </div>
        <!-- End of Page Wrapper -->
        <!-- Scroll to Top Button -->
        <a class="scroll-to-top rounded" href="#page-top">
            <i class="fas fa-angle-up"></i>
        </a><!-- Logout Modal -->
        <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Terminaste?</h5>
                        <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">Seguro que quieres cerrar sesion?.</div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Cancelar</button>
                        <a class="btn btn-primary" href="@Url.Action("IniciarSesion", "Login")">Cerrar Sesion</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bootstrap core JavaScript -->
        <script src="https://cdn.datatables.net/1.13.5/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.0/js/dataTables.buttons.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.0/js/buttons.html5.min.js"></script>
        <script src="https://cdn.datatables.net/buttons/2.4.0/js/buttons.print.min.js"></script>
        <script src="~/Styles/FuncionesJS/DataTables.js"></script>
        <script src="~/Styles/FuncionesJS/FuncionesSweetAlert.js"></script>

        <!-- Core plugin JavaScript -->
        <script src="~/Styles/vendor/jquery-easing/jquery.easing.min.js"></script>
        <script>
            var userId = "@Html.Raw(idUser)";
            var nombreUser = "@Html.Raw(nombreUsuario)"


            if (userId) {
                sessionStorage.setItem("userId", userId);
                sessionStorage.setItem("nombreUser", nombreUser);
            } else {
                console.log("No se encontró un UserId en la sesión.");
            }
        </script>

        <!-- Custom scripts for all pages -->
        <script src="~/Styles/js/sb-admin-2.min.js"></script>
        <script src="~/Scripts/jquery.signalR-2.4.3.min.js"></script>
        <script src="~/signalr/hubs"></script>
        <script src="https://cdn.jsdelivr.net/npm/signalr@3.1.17/dist/browser/signalr.min.js"></script>
        <script>  window.chat = null;</script>
        <script src="~/Styles/FuncionesJS/InitSignalR.js"></script>
        <script>

            function confirmarCerrarSesion(event) {
                event.preventDefault();

                Swal.fire({
                    title: '¿Estás seguro?',
                    text: '¡Cerrar sesión terminará tu sesión actual!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, cerrar sesión',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("CerrarSesion", "Login")';
                    }
                });
            }
        </script>


</body>
</html>

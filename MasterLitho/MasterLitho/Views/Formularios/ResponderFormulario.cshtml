@model MasterLitho.Models.tRespuestaFormulario

@{
    ViewBag.Title = "Responder Formulario";
}

<div class="container mt-4">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white text-center">
            <h2><i class="fas fa-edit"></i> Responder Formulario</h2>
        </div>

        <div class="card-body">
            <h4 class="text-center text-secondary">@Model.nombreFormulario</h4>
            <hr>

            @using (Html.BeginForm("ResponderFormulario", "Formularios", FormMethod.Post, new { id = "formRespuestas" }))
            {
                @Html.HiddenFor(m => m.idFormulario)
                @Html.HiddenFor(m => m.idEmpleado)

                <div class="row g-4">
                    @for (int i = 0; i < Model.campos.Count; i++)
                    {
                        var campo = Model.campos[i];
                        <div class="col-12">
                            <div class="card shadow-sm border-0">
                                <div class="card-body">
                                    <label class="form-label fw-semibold">
                                        <i class="fas fa-question-circle text-primary me-1"></i>
                                        @campo.nombreCampo
                                        @if (campo.esRequerido)
                                        {<span class="text-danger">*</span>}
                                    </label>

                                    @Html.HiddenFor(m => m.campos[i].idCampo)

                                    @if (campo.tipoCampo == "Texto")
                                    {
                                        @Html.TextBoxFor(m => m.campos[i].respuesta, new
                                        {
                                            @class = "form-control rounded-pill",
                                            required = campo.esRequerido ? "required" : null,
                                            placeholder = "Escribe tu respuesta..."
                                        })
                                    }
                                    else if (campo.tipoCampo == "Número")
                                    {
                                        @Html.TextBoxFor(m => m.campos[i].respuesta, new
                                        {
                                            @class = "form-control rounded-pill",
                                            type = "number",
                                            required = campo.esRequerido ? "required" : null,
                                            placeholder = "Ingresa un número"
                                        })
                                    }
                                    else if (campo.tipoCampo == "Fecha")
                                    {
                                        @Html.TextBoxFor(m => m.campos[i].respuesta, new
                                        {
                                            @class = "form-control rounded-pill",
                                            type = "date",
                                            required = campo.esRequerido ? "required" : null
                                        })
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="text-center mt-4">
                    <button type="button" class="btn btn-primary btn-lg rounded-pill px-5 shadow"
                            onclick="validarYConfirmarEnvio()">
                        <i class="fas fa-paper-plane me-2"></i> Enviar Respuestas
                    </button>
                </div>

            }
        </div>
    </div>
</div>

<!-- SweetAlert2 para confirmación -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
<script>
    function validarYConfirmarEnvio() {
        let camposInvalidos = [];
        document.querySelectorAll("input[required]").forEach(input => {
            if (!input.value.trim()) {
                camposInvalidos.push(input);
            }
        });

        if (camposInvalidos.length > 0) {
            alertaError("Por favor, completa todos los campos obligatorios.");
            camposInvalidos[0].focus();
            return;
        }
        confirmarEnvio("Una vez enviadas, las respuestas no se pueden modificar.", "formRespuestas");
    }

</script>


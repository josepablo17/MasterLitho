@{
    ViewBag.Title = "Asignar Formulario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model MasterLitho.Models.FORMULARIO

<div class="card shadow-lg p-4">
    <h2 class="text-center mb-4"><i class="fas fa-file-signature"></i> Asignar Formulario</h2>

    <h4 class="text-muted text-center">@Model.NOMBRE_FORMULARIO</h4>

    @using (Html.BeginForm("AsignarFormulario", "Formularios", FormMethod.Post, new { id = "formAsignar" }))
    {
        @Html.Hidden("idFormulario", Model.ID_FORMULARIO)

        <div class="form-group">
            <label class="font-weight-bold">Seleccionar Empleados:</label>
            <select name="empleadosSeleccionados" id="empleadosDropdown" class="form-control select2" multiple="multiple">
                @foreach (var empleado in ViewBag.listaEmpleados as List<SelectListItem>)
                {
                    <option value="@empleado.Value">@empleado.Text</option>
                }
            </select>
        </div>

        <br>

        <button type="button" class="btn btn-primary btn-lg btn-block" onclick="confirmarAsignacion()">
            <i class="fas fa-paper-plane"></i> Asignar Formulario
        </button>
    }
</div>

<!-- Agregar Select2 y SweetAlert2 para mejor UX -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/css/select2.min.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/select2@4.0.13/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    $(document).ready(function () {
        $('.select2').select2({
            placeholder: "Seleccione empleados...",
            allowClear: true,
            width: "100%"
        });
    });

    function confirmarAsignacion() {
        let empleadosSeleccionados = $('#empleadosDropdown').val();

        if (empleadosSeleccionados.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Atención',
                text: 'Debe seleccionar al menos un empleado.',
                confirmButtonColor: '#3085d6'
            });
            return;
        }

        Swal.fire({
            title: "¿Está seguro?",
            text: "Se asignará este formulario a los empleados seleccionados.",
            icon: "question",
            showCancelButton: true,
            confirmButtonColor: "#28a745",
            cancelButtonColor: "#d33",
            confirmButtonText: "Sí, asignar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    title: "Asignado",
                    text: "El formulario ha sido asignado exitosamente.",
                    icon: "success",
                    showConfirmButton: false,
                    timer: 1500
                });

                setTimeout(() => {
                    document.getElementById("formAsignar").submit();
                }, 1500);
            }
        });
    }
</script>

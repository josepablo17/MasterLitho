@model List<MasterLitho.Models.tFormulario>

@{
    ViewBag.Title = "Consultar Formularios";
}

<style>
    .card {
        width: 100%;
        margin: auto;
        padding: 15px;
        overflow: hidden;
        height: auto;
        max-width: 1200px;
    }
    .card-body {
        padding: 10px 20px;
    }
    .table-responsive {
        max-height: none;
    }

    .container-fluid, #content-wrapper {
        min-height: 120vh;
        width: 75vh;
        max-width: 100%;
        margin: auto;
    }
</style>

<div id="content-wrapper" class="container">
    <div id="content">
        <div class="container text-left mb-4">
            <h1 class="my-4">Gestión de formularios</h1>
            <a href="@Url.Action("CrearFormulario", "Formularios")" class="btn btn-success btn-lg">
                <i class="fas fa-plus-circle" style="font-size: 1.4em;"></i> Crear formulario
            </a>
        </div>

        <div class="container-fluid text-left">
            <div class="card shadow-lg rounded">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary font-weight-bold mb-4">Lista de planillas</h5>
                    <div class="table-responsive">
                        <table id="solicitudesTable" class="table table-hover table-striped text-nowrap align-middle mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>Nombre del formulario</th>
                                    <th>Fecha de envío</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var formulario in Model)
                                {
                                    <tr>
                                        <td>@formulario.nombreFormulario</td>
                                        <td>@formulario.fechaEnvio.ToShortDateString()</td>
                                        <td>
                                            <a class="btn btn-primary btn-sm" href="@Url.Action("DetalleFormulario","Formulario", new { q = formulario.idFormulario })">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("AsignarFormulario", new { idFormulario = formulario.idFormulario })" class="btn btn-warning">Asignar</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        inicializarDataTable('#solicitudesTable');
    });
</script>



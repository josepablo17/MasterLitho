@model List<MasterLitho.Models.tFormularioConRespuesta>

@{
    ViewBag.Title = "Consultar Formularios";
}

<style>
    .card {
        width: 100%;
        margin: auto;
        padding: 15px;
        overflow: hidden;
        height: auto;
        max-width: 1200px;
    }
    .card-body {
        padding: 10px 20px;
    }
    .table-responsive {
        max-height: none;
    }

    .container-fluid, #content-wrapper {
        min-height: 120vh;
        width: 75vh;
        max-width: 100%;
        margin: auto;
    }
</style>

<div id="content-wrapper" class="container">
    <div id="content">
        <div class="container text-left mb-4">
            <h1 class="my-4">Gestión de formularios</h1>
        </div>

        <div class="d-flex justify-content-end mb-3">

            <a href="@Url.Action("CrearFormulario", "Formularios")"
               class="btn btn-success btn-lg rounded-pill shadow-sm">
                <i class="fas fa-plus-circle me-1"></i> Crear nuevo formulario
            </a>
        </div>

        <div class="container-fluid text-left">
            <div class="card shadow-lg rounded">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary font-weight-bold mb-4">Lista de formularios</h5>
                    <div class="table-responsive">
                        <table id="solicitudesTable" class="table table-hover table-striped text-nowrap align-middle mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>Nombre del formulario</th>
                                    <th>Fecha de envío</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var formulario in Model)
                                {
                                    <tr>
                                        <td>@formulario.nombreFormulario</td>
                                        <td>@formulario.fechaEnvio.ToShortDateString()</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("ConsultarDetallesFormulario", "Formularios", new { idFormulario = formulario.idFormulario })"
                                                   class="btn btn-primary"
                                                   title="Ver detalles" data-bs-toggle="tooltip">
                                                    <i class="fas fa-eye"></i> Ver
                                                </a>

                                                <a href="@Url.Action("AsignarFormulario", "Formularios", new { idFormulario = formulario.idFormulario })"
                                                   class="btn btn-warning"
                                                   title="Asignar" data-bs-toggle="tooltip">
                                                    <i class="fas fa-user-plus"></i> Asignar
                                                </a>
                                            </div>

                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        @foreach (var formulario in Model)
                        {
                            if (formulario.respuestas != null && formulario.respuestas.Any())
                            {
                                <div class="accordion mt-3 mb-4" id="respuestasAccordion-@formulario.idFormulario">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="heading-@formulario.idFormulario">
                                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@formulario.idFormulario" aria-expanded="false" aria-controls="collapse-@formulario.idFormulario">
                                                Ver respuestas para: <strong class="ms-2">@formulario.nombreFormulario</strong>
                                            </button>
                                        </h2>
                                        <div id="collapse-@formulario.idFormulario" class="accordion-collapse collapse" aria-labelledby="heading-@formulario.idFormulario" data-bs-parent="#respuestasAccordion-@formulario.idFormulario">
                                            <div class="accordion-body">
                                                <ul class="mb-0">
                                                    @foreach (var empleado in formulario.respuestas)
                                                    {
                                                        <li class="mb-2">
                                                            <i class="fas fa-user me-1 text-primary"></i>
                                                            @empleado.nombreEmpleado
                                                            <a href="@Url.Action("ConsultarRespuestasFormulario", "Formularios", new { idFormulario = formulario.idFormulario, idEmpleado = empleado.idEmpleado })"
                                                               class="btn btn-sm btn-outline-secondary ms-2" title="Ver respuestas">
                                                                <i class="fas fa-eye"></i> Ver Respuestas
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        inicializarDataTable('#solicitudesTable');
    });
</script>



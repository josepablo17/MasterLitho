@model MasterLitho.Models.tUsuario


<div class="page-wrapper d-flex align-items-start justify-content-center min-vh-100" style="background-color: #f9f9f9; padding-top: 5vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-12 col-lg-12">
                <div class="card shadow-lg border-0 rounded-4">
                    <div class="card-body p-4">
                        <div class="text-center mb-4">
                            <a href="@Url.Action("Index", "Home")">
                                <img src="~/Styles/img/martelithocr-logo (1).png" alt="Logo" class="img-fluid" style="width: 120px;">
                            </a>
                        </div>
                        <h4 class="card-title fw-bold text-primary text-center mb-4">
                            <i class="fas fa-user-edit me-2"></i> Actualizar Usuario
                        </h4>

                        @if (ViewBag.MensajePantalla != null)
                        {
                            <div class="alert alert-danger text-center" role="alert">
                                <i class="fas fa-exclamation-circle"></i> @ViewBag.MensajePantalla
                            </div>
                        }

                        @using (Html.BeginForm("ActualizarUsuario", "Usuarios", FormMethod.Post, new { @id = "formActualizarUsuario" }))
                        {
                            @Html.HiddenFor(m => m.idUsuario)

                            <div class="mb-3">
                                <label class="form-label fw-semibold"><i class="fas fa-id-card me-2"></i> Identificación</label>
                                @Html.TextBoxFor(m => m.identificacion, new { @class = "form-control border-primary", @placeholder = "Ingrese la identificacion", @type = "number" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold"><i class="fas fa-user me-2"></i> Nombre de usuario</label>
                                @Html.TextBoxFor(m => m.nombreUsuario, new { @class = "form-control border-primary solo-letras", @placeholder = "Ingrese el nombre del usuario", @type = "text" })
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold"><i class="fas fa-user-tag me-2"></i> Apellidos</label>
                                @Html.TextBoxFor(m => m.apellidoUsuario, new { @class = "form-control border-primary solo-letras", @placeholder = "Ingrese los apellidos", @type = "text" })
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold"><i class="fas fa-envelope me-2"></i> Correo</label>
                                @Html.TextBoxFor(m => m.correoUsuario, new { @class = "form-control border-primary", @type = "email", @readonly = true })
                            </div>
                            <div class="mb-4">
                                <label class="form-label fw-semibold"><i class="fas fa-envelope me-2"></i> Rol</label>
                                @Html.DropDownListFor(m => m.idRol, ViewBag.listaRoles as List<SelectListItem>, new { @class = "form-control" })
                            </div>

                            <div class="d-grid gap-3">
                                <button type="submit" class="btn btn-primary btn-lg shadow" id="cambiarPass">
                                    <i class="fas fa-save me-2"></i> Realizar Cambio
                                </button>

                                <a class="nav-link btn btn-secondary btn-lg shadow" href="@Url.Action("GestionUsuarios", "Usuarios")">
                                    <span>Volver</span>
                                </a>
                            </div>
                        }


                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.solo-letras').forEach(input => {
        input.addEventListener('keypress', function (e) {
            const char = String.fromCharCode(e.which || e.keyCode);
            if (!/^[a-zA-Z\s]+$/.test(char)) {
                e.preventDefault();
            }
        });

        input.addEventListener('input', function () {
            this.value = this.value.replace(/[^a-zA-Z\s]/g, '');
        });
    });
</script>

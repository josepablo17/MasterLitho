<div id="content-wrapper" class="container">
    <div id="content">
        <h1 class="my-4">Gestión de usuarios</h1>
        <div class="container mb-4">
            <div class="d-flex justify-content-end mb-3">
                <!-- Botón para agregar usuario -->
                <a href="@Url.Action("RegistrarUsuario", "Usuarios")" class="btn btn-success btn-lg rounded-pill shadow-sm me-2">
                    <i class="fas fa-plus-circle me-1"></i> Agregar Usuario
                </a>

                <!-- Botón para ver empleados -->
                <a href="@Url.Action("ConsultarEmpleados", "Empleado")" class="btn btn-info btn-lg rounded-pill shadow-sm">
                    <i class="fas fa-users" style="font-size: 1.4em;"></i> Ver Empleados
                </a>
            </div>
        </div>
        <div class="container-fluid">
            <div class="card shadow-lg rounded">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary font-weight-bold mb-4">Usuarios</h5>
                    <div class="table-responsive">
                        <table id="UsuariosTable" class="table table-hover table-striped text-nowrap align-middle mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre usuario</th>
                                    <th>Apellidos</th>
                                    <th>Correo</th>
                                    <th>Rol</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.idUsuario</td>
                                        <td>@item.nombreUsuario</td>
                                        <td>@item.apellidoUsuario</td>
                                        <td>@item.correoUsuario</td>
                                        <td>@item.NombreRol</td>
                                        <td>@item.estado</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="@Url.Action("ActualizarUsuario", "Usuarios", new {q = item.idUsuario})" class="btn btn-primary btn">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <button type="button" class="btn btn-danger btn abrirModal"
                                                        data-id="@item.idUsuario"
                                                        data-name="@item.nombreUsuario"
                                                        data-bs-toggle="modal" data-bs-target="#modalUsuarios">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                                </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación -->
<div class="modal fade" id="modalUsuarios" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("ActualizarEstadoUsuario", "Usuarios", FormMethod.Post))
            {
                <div class="modal-body">
                    @Html.Hidden("idUsuario", "", new { id = "idUsuario" })
                    ¿Desea cambiar el estado del usuario <label id="nombreUsuario"></label>?
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Procesar</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        inicializarDataTable('#solicitudesTable');
    });
</script>

<!-- Archivos JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/Styles/FuncionesJS/FuncionesGestioUsuario.js"></script>

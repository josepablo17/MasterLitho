@model List<MasterLitho.Models.tUsuario>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Agregar los recursos de Bootstrap y Font Awesome -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div id="content-wrapper" class="container">
    <div id="content">
        <h1 class="my-4">Gestión y Aprobación de Solicitudes de Vacaciones</h1>
        <div class="container mb-4">
            <div class="d-flex justify-content-start">
                <a href="@Url.Action("RegistrarUsuario", "Usuarios")" class="btn btn-success btn-lg">
                    <i class="fas fa-plus-circle" style="font-size: 1.4em;"></i> Agregar Usuario
                </a>
            </div>
        </div>
        <div class="container-fluid">
            <div class="card shadow-lg rounded">
                <div class="card-body">
                    <h5 class="card-title text-center text-primary font-weight-bold mb-4">Lista de solicitudes</h5>
                    <div class="table-responsive">
                        <table id="UsuariosTable" class="table table-hover table-striped text-nowrap align-middle mb-0 w-100">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre usuario</th>
                                    <th>Apellidos</th>
                                    <th>Correo</th>
                                    <th>Rol</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.idUsuario</td>
                                        <td>@item.nombreUsuario</td>
                                        <td>@item.apellidoUsuario</td>
                                        <td>@item.correoUsuario</td>
                                        <td>@item.NombreRol</td>
                                        <td>@item.estado</td>
                                        <td>

                                            <a href="@Url.Action("ActualizarUsuario", "Usuarios", new {q = item.idUsuario})" class="btn btn-primary btn-sm">
                                                <i class="bi bi-pencil"></i>
                                            </a>


                                            <button type="button" class="btn btn-danger btn-sm abrirModal"
                                                    data-id="@item.idUsuario"
                                                    data-name="@item.nombreUsuario"
                                                    data-bs-toggle="modal" data-bs-target="#modalUsuarios">
                                                <i class="fas fa-trash-alt" style="font-size: 1.4em;"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalUsuarios" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="staticBackdropLabel">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("ActualizarEstadoUsuario", "Usuarios", FormMethod.Post))
            {
                <div class="modal-body">
                    @Html.Hidden("idUsuario", "", new { id = "idUsuario" })

                    ¿Desea cambiar el estado del usuario <label id="nombreUsuario"></label>?
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">Procesar</button>
                </div>
            }


        </div>
    </div>
</div>

<!-- Archivos JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/Styles/FuncionesJS/DataTables.js"></script>
<script src="~/Styles/FuncionesJS/FuncionesGestioUsuario.js"></script>



